          height: 280px;
          max-height: 280px;
          min-height: 280px;
        }
        .octane-timer-wrap {
          align-items: center;
          container-name: octane-timer-display;
          container-type: size;
          display: flex;
          flex: 1 1 auto;
          height: 100%;
          justify-content: center;
          min-height: 0;
          min-width: 0;
          width: 100%;
        }
