            execution: [
              {limit: 20, token: COLOR_BAD},
              {limit: 79, token: COLOR_WARN},
              {limit: 100, token: COLOR_GOOD}
            ],
            passRate: [
              {limit: 49, token: COLOR_BAD},
              {limit: 89, token: COLOR_WARN},
              {limit: 100, token: COLOR_GOOD}
            ],
            poll: [
              {limit: 100, token: COLOR_NEUTRAL}
            ],
            timeout: [
