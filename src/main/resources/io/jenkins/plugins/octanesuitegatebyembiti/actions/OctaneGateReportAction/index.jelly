        .octane-report-zone .octane-chart-card.octane-expanded .octane-muted,
        .octane-report-zone .octane-chart-card.octane-expanded .octane-total-label,
        .octane-report-zone .octane-chart-card.octane-expanded .octane-legend-row {
          font-size: clamp(0.612rem, 1.5cqw, 0.808rem);
        }
        .octane-chart-card.octane-expanded .octane-timer-wrap,
        .octane-chart-card.octane-expanded .octane-flip-viewport,
        .octane-chart-card.octane-expanded .octane-flip-face-body,
        .octane-chart-card.octane-expanded .octane-chart-inner {
          flex: 1 1 auto;
          min-height: 0;
        }
        .octane-chart-card.octane-expanded .octane-donut-graph {
          height: auto;
        }
        .octane-chart-card.octane-expanded .octane-timer-donut {
          height: min(100cqw, 100cqh, 76vh, 76vw);
          max-height: min(76vh, 76vw);
          max-width: min(76vh, 76vw);
          width: min(100cqw, 100cqh, 76vh, 76vw);
        }
        .octane-chart-card.octane-expanded .octane-activity-rings-svg {
          height: min(100cqw, 100cqh, 76vh, 76vw);
          max-height: min(76vh, 76vw);
