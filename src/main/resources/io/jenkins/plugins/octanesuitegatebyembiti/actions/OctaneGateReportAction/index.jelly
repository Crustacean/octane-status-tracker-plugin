          font-weight: 600;
          justify-content: center;
          max-width: min(96%, 28rem);
          min-height: clamp(1rem, 4.4cqh, 2rem);
          overflow: visible;
          padding: clamp(0.12rem, 0.65cqh, 0.36rem) clamp(0.34rem, 1.3cqw, 0.78rem);
          text-overflow: clip;
          width: fit-content;
          white-space: nowrap;
