        .octane-activity-ring-swatch.octane-activity-ring-execution {
          background: #FA114F;
        }
        .octane-activity-ring-swatch.octane-activity-ring-pass {
          background: #A6FF00;
        }
        .octane-activity-ring-swatch.octane-activity-ring-automation {
          background: #00FFF6;
        }
        .octane-activity-side-legend {
          border-collapse: collapse;
          color: var(--text-color);
          display: none;
          font-size: clamp(0.68rem, 1.45cqw, 0.9rem);
          font-variant-numeric: tabular-nums;
          justify-self: center;
          line-height: 1.2;
          table-layout: fixed;
          width: min(100%, 18rem);
        }
        .octane-activity-side-legend caption {
          border: 0;
          clip-path: inset(50%);
          height: 1px;
          overflow: hidden;
          position: absolute;
          white-space: nowrap;
          width: 1px;
        }
        .octane-activity-side-legend th,
        .octane-activity-side-legend td {
          border: 0;
          padding-block: clamp(0.28rem, 0.8cqw, 0.52rem);
          white-space: nowrap;
        }
        .octane-activity-side-legend th {
          font-weight: 600;
          padding-inline: 0 1rem;
          text-align: left;
        }
        .octane-activity-side-legend td {
          font-weight: 600;
          text-align: right;
          width: 8ch;
        }
        .octane-activity-side-legend-label {
          align-items: center;
          display: inline-flex;
          gap: 0.45rem;
        }
        @container octane-activity-rings (min-width: 36rem) {
          .octane-activity-rings[data-side-legend-visible="true"]
              .octane-activity-side-legend {
            display: table;
            inset-inline-end: 0;
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            width: min(30%, 18rem);
          }
        }
        @container octane-activity-legend (max-width: 34rem) {
          .octane-activity-legend-full {
            display: none;
          }
          .octane-activity-legend-compact {
            display: inline;
          }
        }
        .octane-timer-track {
          fill: none;
          opacity: 0.5;
          stroke: var(--panel-border-color);
          stroke-width: 1;
        }
        .octane-timer-progress {
          fill: none;
          opacity: 1;
          stroke-linecap: round;
          stroke-width: 16;
        }
        .octane-timer-value {
          fill: var(--text-color);
          font-size: 2.6082rem;
          font-weight: 700;
          text-anchor: middle;
        }
        .octane-timer-unit {
          fill: var(--text-color-secondary);
          font-size: 0.91875rem;
          text-anchor: middle;
        }
        .octane-timer-unit-compact {
          display: none;
        }
        @container octane-timer-display (max-width: 18rem) {
          .octane-timer-unit-full {
            display: none;
          }
          .octane-timer-unit-compact {
            display: inline;
          }
        }
        @media (max-width: 480px) {
          .octane-timer-unit-full {
            display: none;
          }
          .octane-timer-unit-compact {
            display: inline;
          }
        }
        .octane-chart-inner {
          box-sizing: border-box;
          margin-top: 1rem;
          width: 100%;
        }
        .octane-donut-graph {
          --octane-axis-label-row: 1.7rem;
          height: calc(260px + var(--octane-axis-label-row));
          min-height: 0;
          overflow: hidden;
          padding: 0;
        }
        .octane-donut-layout {
          align-items: center;
          display: grid;
          gap: clamp(0.125rem, 0.75cqw, 0.375rem);
          grid-template-columns: minmax(0, 1fr) max-content;
          height: 100%;
          justify-content: center;
          min-height: 0;
          padding: 0;
          width: 100%;
        }
        .octane-donut-wrap {
          align-items: center;
          box-sizing: border-box;
          container-type: size;
          display: flex;
          height: 100%;
          justify-content: center;
          min-height: 0;
          min-width: 0;
          overflow: hidden;
          padding: 5px;
          width: 100%;
        }
        .octane-donut {
          aspect-ratio: 1 / 1;
          display: block;
          height: min(100cqw, 100cqh);
          max-height: none;
          max-width: none;
          overflow: hidden;
          shape-rendering: geometricPrecision;
          width: min(100cqw, 100cqh);
        }
        .octane-donut-center-value {
          fill: var(--text-color);
          font-family: "Hanken Grotesk", Inter, "Segoe UI", Arial, sans-serif;
          font-size: 0.72rem;
          font-weight: 700;
          pointer-events: none;
        }
        .octane-donut-center-label {
          fill: var(--text-color-secondary);
          font-family: Inter, "Segoe UI", Arial, sans-serif;
          font-size: 0.2875rem;
          font-weight: 500;
          pointer-events: none;
        }
        .octane-donut-segment {
          stroke: none;
        }
        .octane-donut-hole {
          fill: var(--background);
        }
        .octane-donut-legend {
          border-collapse: collapse;
          color: var(--text-color);
          font-family: Inter, "Segoe UI", Arial, sans-serif;
          font-size: clamp(0.62rem, 2.1cqw, 0.9rem);
          font-variant-numeric: tabular-nums;
          justify-self: center;
          line-height: 1.2;
          width: auto;
        }
        .octane-donut-legend caption {
          border: 0;
          clip-path: inset(50%);
          height: 1px;
          overflow: hidden;
          position: absolute;
          white-space: nowrap;
          width: 1px;
        }
        .octane-donut-legend th,
        .octane-donut-legend td {
          border: 0;
          padding-block: clamp(0.16rem, 0.7cqw, 0.36rem);
          white-space: nowrap;
        }
        .octane-donut-legend-status {
          font-weight: 600;
          padding-inline: 0 clamp(0.5rem, 2.2cqw, 1.5625rem);
          text-align: left;
        }
        .octane-donut-legend-label {
          align-items: center;
          display: inline-flex;
          gap: clamp(0.3rem, 1cqw, 0.48rem);
        }
        .octane-donut-legend-label .octane-swatch {
          flex: 0 0 auto;
        }
        .octane-automation-icon {
          align-items: center;
          display: inline-flex;
          flex: 0 0 0.8rem;
          height: 0.8rem;
          justify-content: center;
          line-height: 1;
          text-align: center;
          width: 0.8rem;
        }
        .octane-donut-legend-percentage {
          font-weight: 600;
          padding-inline: 0;
          text-align: right;
        }
        .octane-total-label {
          color: var(--text-color-secondary);
        }
        .octane-suite-chart-meta {
          align-items: center;
          display: flex;
          flex-wrap: wrap;
          gap: 0.35rem 0.75rem;
          margin-top: 0.25rem;
        }
        .octane-axis-value {
          color: #827C7B;
          font-family: Inter, "Segoe UI", Arial, sans-serif;
          font-size: 12px;
          font-size: clamp(0.66rem, 2.1cqw, 0.75rem);
          font-weight: 400;
        }
        .octane-bar-graph {
          --octane-axis-label-row: 1.7rem;
          column-gap: 0.09rem;
          display: grid;
          grid-template-columns: 1.35rem max-content minmax(0, 1fr);
          grid-template-rows: 260px var(--octane-axis-label-row);
          row-gap: 0;
        }
        .octane-y-axis-label {
          align-self: center;
          color: #827C7B;
          font-family: Inter, "Segoe UI", Arial, sans-serif;
          font-size: 12px;
          font-size: clamp(0.66rem, 2.1cqw, 0.75rem);
          font-weight: 400;
          grid-column: 1;
          grid-row: 1;
          justify-self: center;
          transform: rotate(180deg);
          white-space: nowrap;
          writing-mode: vertical-rl;
        }
        .octane-y-axis-scale {
          align-items: end;
          display: flex;
          flex-direction: column;
          grid-column: 2;
          grid-row: 1;
          justify-content: space-between;
          min-width: 0;
          padding-right: 0.2rem;
        }
        .octane-bar-plot {
          box-sizing: border-box;
          grid-column: 3;
          grid-row: 1 / span 2;
          min-width: 0;
          overflow: visible;
          position: relative;
        }
        .octane-bar-plot::before {
          background-image: radial-gradient(
            circle,
            rgba(33, 38, 45, 0.92) 0 1px,
            transparent 1.2px
          );
          background-size: 0.55rem calc(100% / var(--octane-grid-line-count, 4));
          bottom: var(--octane-axis-label-row);
          content: "";
          left: 0;
          pointer-events: none;
          position: absolute;
          right: 0;
          top: 0;
          z-index: 0;
        }
        .octane-bar-plot::after {
          background: #30363D;
          bottom: var(--octane-axis-label-row);
          content: "";
          height: 1px;
          left: 0;
          pointer-events: none;
          position: absolute;
          right: 0;
          z-index: 0;
        }
        .octane-legend {
          align-items: center;
          display: flex;
          flex-wrap: wrap;
          gap: 0.35rem 0.65rem;
        }
        .octane-legend-row {
          align-items: center;
          display: inline-flex;
          column-gap: 0.35rem;
          white-space: nowrap;
        }
        .octane-swatch {
          border-radius: 2px;
          display: inline-block;
          height: 0.8rem;
          width: 0.8rem;
        }
        .octane-vertical-bars {
          align-items: stretch;
          box-sizing: border-box;
          display: flex;
          gap: clamp(2px, 1vw, 40px);
          gap: var(--octane-bar-gap, clamp(2px, 1cqw, 40px));
          height: 100%;
          justify-content: center;
          min-height: 0;
          overflow-x: hidden;
          overflow-y: visible;
          padding: 0;
          width: 100%;
        }
        .octane-vertical-bars.octane-fluid-bars-dense {
          justify-content: center;
        }
        .octane-bar-overflow-indicator {
          align-self: stretch;
          box-sizing: border-box;
          display: grid;
          flex: 0 0 24px;
          grid-template-rows: minmax(0, 1fr) var(--octane-axis-label-row);
          height: 100%;
          max-width: 24px;
          min-width: 24px;
          position: relative;
          width: 24px;
          z-index: 2;
        }
        .octane-bar-overflow-line {
          align-self: end;
          background: var(--background, var(--octane-card-background));
          border-bottom: 2px dashed #666;
          box-sizing: border-box;
          grid-row: 1;
          height: 3px;
          width: 100%;
        }
        .octane-bar-overflow-count {
          align-self: start;
          color: #888;
          font-size: 10px;
          grid-row: 2;
          justify-self: end;
          line-height: 1.1;
          padding-top: 3px;
          white-space: nowrap;
        }
        .octane-vertical-bars::before,
        .octane-vertical-bars::after {
          content: "";
          display: none;
        }
        .octane-suite-column {
          align-items: center;
          display: grid;
          flex: 1 1 auto;
          flex-basis: var(--octane-bar-width, clamp(8px, 4cqw, 100px));
          grid-template-rows: minmax(0, 1fr) var(--octane-axis-label-row);
          height: 100%;
          justify-items: center;
          max-width: 100px;
          min-width: 8px !important;
          position: relative;
          width: var(--octane-bar-width, auto);
        }
        .octane-vertical-bar-wrap {
          align-items: end;
          display: flex;
          grid-row: 1;
          height: 100%;
          justify-content: center;
          min-height: 0;
          width: 100%;
          z-index: 1;
        }
        .octane-vertical-bar {
          align-items: stretch;
          align-self: end;
          background: var(--panel-border-color);
          border-radius: 0;
          display: flex;
          flex-direction: column-reverse;
          height: 100%;
          max-width: 100px;
          min-width: 8px !important;
          overflow: hidden;
          width: 100%;
        }
        .octane-bar-popup {
          background: var(--background);
          border: 1px solid var(--octane-popup-border-color, var(--panel-border-color));
          border-radius: 8px;
          box-sizing: border-box;
          box-shadow:
              0 0 0 1px var(--octane-popup-border-color, transparent),
              0 0.45rem 1.4rem rgba(0, 0, 0, 0.18);
          color: var(--text-color);
          display: grid;
          font-size: 0.644rem;
          gap: 0.32rem;
          left: 0;
          max-width: min(18rem, calc(100vw - 1rem));
          min-width: min(10.92rem, calc(100vw - 1rem));
          opacity: 0;
          padding: 0.5rem 0.6rem;
          pointer-events: none;
          position: fixed;
          top: 0;
          transition: opacity 90ms ease;
          visibility: hidden;
          will-change: left, top;
          z-index: 2147483647;
        }
        .octane-bar-popup.octane-bar-popup-visible {
          opacity: 1;
          visibility: visible;
        }
        .octane-bar-popup.octane-bar-popup-restoring {
          transition: none;
        }
        .octane-bar-popup-name {
          border-bottom: 1px solid var(--panel-border-color);
          font-weight: 700;
          line-height: 1.25;
          overflow-wrap: anywhere;
          padding-bottom: 0.32rem;
          white-space: normal;
        }
        .octane-bar-popup-row {
          align-items: center;
          display: grid;
          gap: 0.32rem;
          grid-template-columns: 0.55rem minmax(0, 1fr) auto auto;
        }
        .octane-bar-popup .octane-swatch {
          height: 0.55rem;
          width: 0.55rem;
        }
        .octane-bar-popup-label {
          overflow-wrap: anywhere;
          white-space: normal;
        }
        .octane-bar-popup-value,
        .octane-bar-popup-percent,
        .octane-bar-popup-total-value {
          font-weight: 700;
          text-align: right;
        }
        .octane-bar-popup-total {
          border-top: 1px solid var(--panel-border-color);
          display: flex;
          justify-content: space-between;
          padding-top: 0.32rem;
        }
        .octane-bar-popup-automation {
          align-items: center;
          display: grid;
          gap: 0.32rem;
          grid-template-columns: 0.55rem minmax(0, 1fr) auto;
        }
        .octane-bar-popup-automation .octane-automation-icon {
          flex-basis: 0.55rem;
          height: 0.55rem;
          width: 0.55rem;
        }
        .octane-vertical-segment {
          display: block;
          width: 100%;
        }
        .octane-suite-label {
          align-self: start;
          box-sizing: border-box;
          display: block;
          color: #827C7B;
          font-family: Inter, "Segoe UI", Arial, sans-serif;
          font-size: 12px;
          font-weight: 400;
          grid-row: 2;
          line-height: 1.1;
          max-width: min(100%, 6.8rem);
          min-height: 1rem;
          overflow: hidden;
          padding-top: 0.18rem;
          text-align: center;
          text-overflow: ellipsis;
          transform: none;
          transform-origin: center;
          white-space: nowrap;
          width: 100%;
        }
        .octane-suite-label[data-axis-label-rotation="45"],
        .octane-suite-label[data-axis-label-rotation="90"] {
          justify-self: center;
          max-width: var(--octane-axis-label-max-width, 4rem);
          min-height: 0;
          padding-top: 0;
          text-align: right;
          transform-origin: right top;
          width: max-content;
        }
        .octane-suite-label[data-axis-label-rotation="45"] {
          transform: translateX(-50%) rotate(-45deg);
        }
        .octane-suite-label[data-axis-label-rotation="90"] {
          font-size: 9px;
          transform: translateX(-50%) rotate(-90deg);
        }
        .octane-chart-data-summary {
          border-collapse: collapse;
        }
        @supports not (font-size: 1cqw) {
          .octane-card-title {
            font-size: clamp(0.72rem, 1vw, 1rem);
          }
          .octane-card-header .octane-muted,
          .octane-flip-face-header .octane-muted,
          .octane-total-label,
          .octane-legend-row {
            font-size: clamp(0.58rem, 0.9vw, 0.88rem);
          }
          .octane-test-metric-heading {
            font-size: clamp(0.5rem, 1.1vw, 1rem);
          }
          .octane-test-metric-value {
            font-size: clamp(1.26rem, 7vw, 5rem);
          }
          .octane-test-metric-detail,
          .octane-test-metric-trend {
            font-size: clamp(0.6rem, 1.5vw, 1.25rem);
          }
        }
        @media (prefers-reduced-motion: reduce) {
          .octane-flip-face,
          .octane-bar-popup {
            transition: none !important;
          }
        }
        .octane-empty {
          border: 1px dashed var(--input-border);
          border-radius: 8px;
          color: var(--text-color-secondary);
          padding: 1rem;
        }
        .octane-tester-details-zone {
          background: var(--background);
          border: 1px solid var(--background);
          border-radius: 8px;
          box-sizing: border-box;
          container-name: tester-details;
          container-type: inline-size;
          display: flex;
          flex-direction: column;
          max-height: calc(100vh - 2rem);
          overflow: hidden;
          width: 100%;
        }
        .octane-tester-details-header {
          align-items: center;
          border-bottom: 1px solid var(--input-border);
          display: flex;
          flex: 0 0 auto;
          gap: clamp(0.5rem, 1.5vw, 1rem);
          justify-content: space-between;
          min-height: clamp(2.75rem, 6vh, 4rem);
          padding: clamp(0.65rem, 1.5vw, 1rem) clamp(0.75rem, 2vw, 1.25rem);
        }
        .octane-tester-details-title {
          font-size: clamp(0.95rem, 1.5vw, 1.25rem);
          font-weight: 600;
          line-height: 1.25;
          margin: 0;
        }
        .octane-tester-details-toggle {
          align-items: center;
          appearance: none;
          background: transparent;
          border: 0;
          border-radius: 4px;
          color: var(--text-color-secondary);
          cursor: pointer;
          display: inline-flex;
          flex: 0 0 auto;
          height: 1.5rem;
          justify-content: center;
          padding: 0;
          width: 1.5rem;
        }
        .octane-tester-details-toggle:hover {
          background: var(--panel-border-color);
          color: var(--text-color);
        }
        .octane-tester-details-toggle .octane-icon-tester-expand {
          display: none;
        }
        .octane-tester-details-toggle[aria-expanded="false"] .octane-icon-tester-collapse {
          display: none;
        }
        .octane-tester-details-toggle[aria-expanded="false"] .octane-icon-tester-expand {
          display: block;
        }
        .octane-tester-details-body {
          display: grid;
          flex: 1 1 auto;
          grid-template-columns: minmax(0, 1fr);
          max-height: calc(100vh - 6rem);
          min-height: 0;
          overflow: hidden;
        }
        .octane-tester-details-body[hidden] {
          display: none;
        }
        .octane-tester-tracker {
          container-name: tester-tracker;
          container-type: inline-size;
          display: grid;
          grid-template-rows: auto minmax(0, 1fr);
          min-height: 0;
          min-width: 0;
        }
        .octane-tester-tracker + .octane-tester-tracker {
          border-top: 1px solid var(--input-border);
        }
        .octane-tester-tracker-title {
          font-size: clamp(0.7rem, 3.2cqi, 1rem);
          font-weight: 600;
          line-height: 1.35;
          margin: 0;
          max-width: 100%;
          min-width: 0;
          overflow: hidden;
          padding: clamp(0.7rem, 1.6vw, 1.1rem) clamp(0.75rem, 2vw, 1.25rem);
          text-overflow: ellipsis;
          text-wrap: nowrap;
          white-space: nowrap;
        }
        .octane-tester-column-content {
          max-height: min(58vh, 36rem);
          min-height: clamp(12rem, 28vh, 22rem);
          overflow-x: hidden;
          overflow-y: auto;
          overscroll-behavior: contain;
          scrollbar-color: #666 transparent;
          scrollbar-width: thin;
        }
        .octane-tester-column-content::-webkit-scrollbar {
          width: 6px;
        }
        .octane-tester-column-content::-webkit-scrollbar-track {
          background: transparent;
        }
        .octane-tester-column-content::-webkit-scrollbar-thumb {
          background: #666;
          border-radius: 4px;
        }
        .octane-tester-column-content::-webkit-scrollbar-thumb:hover {
          background: #888;
        }
        .octane-tester-table {
          border-collapse: collapse;
          box-sizing: border-box;
          inline-size: 100%;
          max-width: 100%;
          min-width: 0;
          table-layout: auto;
          width: 100%;
        }
        .octane-tester-table[hidden] {
          display: none;
        }
        .octane-tester-column-content[data-empty="true"] {
          display: flex;
          flex-direction: column;
        }
        .octane-tester-column-content[data-empty="true"] .octane-tester-table tbody,
        .octane-tester-column-content[data-empty="false"] .octane-tester-empty-state {
          display: none;
        }
        .octane-tester-table th,
        .octane-tester-table td {
          border-bottom: 1px solid var(--input-border);
          box-sizing: border-box;
          font-size: clamp(0.75rem, 1.2vw, 1rem);
          line-height: 1.35;
          min-height: clamp(2.4rem, 5vh, 3.4rem);
          padding: clamp(0.55rem, 1.2vw, 0.85rem) clamp(0.75rem, 2vw, 1.25rem);
          vertical-align: middle;
        }
        .octane-tester-table thead th {
          background: var(--background);
          color: var(--text-color-secondary);
          font-weight: 500;
          position: sticky;
          top: 0;
          z-index: 1;
        }
        .octane-tester-email {
          overflow-wrap: anywhere;
          text-align: left;
        }
        .octane-tester-rate {
          font-variant-numeric: tabular-nums;
          text-align: right;
          white-space: nowrap;
        }
        .octane-tester-table thead .octane-tester-rate-header {
          font-size: clamp(0.7rem, 3.2cqi, 1rem);
          max-width: 100%;
          overflow: hidden;
          overflow-wrap: normal;
          padding-inline-end: clamp(0.75rem, 2vw, 1.25rem);
          text-align: right;
          text-overflow: ellipsis;
          text-wrap: nowrap;
          white-space: nowrap;
          word-break: normal;
        }
        .octane-tester-responsive-prefix {
          display: inline;
        }
        .octane-tester-comparison-full {
          display: inline;
        }
        .octane-tester-comparison-compact {
          display: none;
        }
        @container tester-tracker (max-width: 24rem) {
          .octane-tester-responsive-prefix,
          .octane-tester-comparison-full {
            display: none;
          }
          .octane-tester-comparison-compact {
            display: inline;
          }
        }
        .octane-scope-project {
          overflow-wrap: anywhere;
          text-align: left;
          width: 58%;
        }
        .octane-scope-owner {
          overflow-wrap: anywhere;
          text-align: left;
          width: 42%;
        }
        @container tester-details (max-width: 35rem) {
          .octane-tester-table th,
          .octane-tester-table td {
            font-size: 0.72rem;
          }
        }
        .octane-tester-empty-state {
          align-items: center;
          box-sizing: border-box;
          color: #000000;
          display: flex;
          font-size: clamp(1.35rem, 3vw, 2.5rem);
          font-weight: 600;
          flex: 1 1 auto;
          justify-content: center;
          min-height: 0;
          padding: clamp(1rem, 4vw, 3rem);
          text-align: center;
        }
        .octane-tester-empty-state[hidden] {
