<?jelly escape-by-default='true'?>
<j:jelly xmlns:f="/lib/form" xmlns:j="jelly:core" xmlns:l="/lib/layout">
  <l:layout title="${it.displayName}">
    <l:main-panel>
      <style>
        .octane-report {
          max-width: 100%;
        }
        .octane-report h1 {
          margin-bottom: 0.25rem;
        }
        .octane-muted {
          color: var(--text-color-secondary);
        }
        .octane-visually-hidden:where(:not(:focus-within, :active)) {
          border: 0 !important;
          clip-path: inset(50%) !important;
          height: 1px !important;
          margin: -1px !important;
          overflow: hidden !important;
          padding: 0 !important;
          position: absolute !important;
          white-space: nowrap !important;
          width: 1px !important;
        }
        .octane-live-update {
          display: inline;
          margin-left: 0.35rem;
          white-space: nowrap;
        }
        .octane-live-update-last-updated {
          text-transform: uppercase;
        }
        .octane-connectivity-status {
          background: var(--card-background, var(--background, #ffffff));
          border: 1px solid var(--octane-system-red);
          color: var(--text-color, #1f2328);
          flex: 1 0 100%;
          font-size: 0.875rem;
          font-weight: 600;
          padding: 0.55rem 0.75rem;
          position: sticky;
          top: 0.5rem;
          z-index: 100;
        }
        .octane-connectivity-status[data-state="restored"] {
          border-color: var(--octane-system-green);
        }
        .octane-connectivity-status[hidden] {
          display: none;
        }
        .octane-dashboard {
          --octane-system-blue: #007AFF;
          --octane-system-gray: #8E8E93;
          --octane-system-good: #0f766e;
          --octane-system-bad: #4338ca;
          --octane-system-green: #34C759;
          --octane-system-orange: #FF9500;
          --octane-system-purple: #AF52DE;
          --octane-system-red: #FF3B30;
          --octane-system-yellow: #FFCC00;
          --octane-color-bad: var(--octane-system-red);
          --octane-color-good: var(--octane-system-green);
          --octane-color-neutral: var(--octane-system-blue);
          --octane-color-on-emphasis: #000000;
          --octane-color-warn: var(--octane-system-yellow);
          --octane-severity-critical: var(--octane-system-red);
          --octane-severity-high: var(--octane-system-orange);
          --octane-severity-low: #5AC8FA;
          --octane-severity-medium: var(--octane-system-purple);
          --octane-severity-unspecified: var(--octane-system-gray);
          --octane-severity-very-high: var(--octane-system-yellow);
          --octane-status-blocked: var(--octane-system-orange);
          --octane-status-failed: var(--octane-system-red);
          --octane-status-no-run: var(--octane-system-gray);
          --octane-status-passed: var(--octane-system-green);
          --octane-status-skipped: var(--octane-system-purple);
          align-items: stretch;
          display: flex;
          flex-wrap: wrap;
          gap: 1rem;
          margin-top: 1rem;
        }
        @media (prefers-color-scheme: dark) {
          .octane-dashboard {
            --octane-system-blue: #0A84FF;
            --octane-system-good: #198980;
            --octane-system-bad: #7268ED;
            --octane-system-green: #30D158;
            --octane-system-orange: #FF9F0A;
            --octane-system-purple: #BF5AF2;
            --octane-system-red: #FF453A;
            --octane-system-yellow: #FFD60A;
            --octane-severity-low: #64D2FF;
          }
        }
        html[data-theme="dark"] .octane-dashboard,
        body[data-theme="dark"] .octane-dashboard,
        [data-color-mode="dark"] .octane-dashboard,
        .jenkins-theme-dark .octane-dashboard,
        .theme-dark .octane-dashboard {
          --octane-system-blue: #0A84FF;
          --octane-system-good: #198980;
          --octane-system-bad: #7268ED;
          --octane-system-green: #30D158;
          --octane-system-orange: #FF9F0A;
          --octane-system-purple: #BF5AF2;
          --octane-system-red: #FF453A;
          --octane-system-yellow: #FFD60A;
          --octane-severity-low: #64D2FF;
        }
        html[data-theme="light"] .octane-dashboard,
        body[data-theme="light"] .octane-dashboard,
        [data-color-mode="light"] .octane-dashboard,
        .jenkins-theme-light .octane-dashboard,
        .theme-light .octane-dashboard {
          --octane-system-blue: #007AFF;
          --octane-system-good: #0f766e;
          --octane-system-bad: #4338ca;
          --octane-system-green: #34C759;
          --octane-system-orange: #FF9500;
          --octane-system-purple: #AF52DE;
          --octane-system-red: #FF3B30;
          --octane-system-yellow: #FFCC00;
          --octane-severity-low: #5AC8FA;
        }
        .octane-exit-extended-form {
          align-items: center;
          display: flex;
          flex-wrap: wrap;
          gap: 0.65rem;
          margin-top: 0.85rem;
        }
        .octane-exit-extended-form form {
          align-items: center;
          display: flex;
          flex-wrap: wrap;
          gap: 0.65rem;
          margin: 0;
        }
        .octane-exit-extended-form[data-visible="false"] {
          display: none;
        }
        .octane-exit-extended-command[data-visible="false"],
        .octane-exit-finalizing-status[data-visible="false"] {
          display: none;
        }
        .octane-exit-finalizing-status {
          color: var(--text-color-secondary);
          font-weight: 500;
        }
        .octane-timer-zone,
        .octane-test-management-zone,
        .octane-report-zone {
          align-items: stretch;
          border: 1px solid var(--background);
          border-radius: 8px;
          box-sizing: border-box;
          display: flex;
          flex-wrap: wrap;
          gap: 1rem;
          padding: 1.5rem 1rem 1rem;
          position: relative;
          width: 100%;
        }
        .octane-zone-focus-toggle {
          align-items: center;
          appearance: none;
          background: transparent;
          border: 0;
          border-radius: 4px;
          color: var(--text-color-secondary);
          cursor: pointer;
          display: inline-flex;
          height: 1.15rem;
          justify-content: center;
          padding: 0;
          position: absolute;
          right: 0.35rem;
          top: 0.2rem;
          width: 1.15rem;
          z-index: 2;
        }
        .octane-zone-focus-toggle:hover {
          background: var(--panel-border-color);
          color: var(--text-color);
        }
        .octane-zone-focus-toggle:focus-visible,
        .octane-expand-toggle:focus-visible,
        .octane-client-page-button:focus-visible,
        .octane-view-toggle:focus-visible,
        .octane-tester-details-toggle:focus-visible,
        .octane-exit-extended-button:focus-visible,
        .octane-card-tools:focus-visible,
        .octane-suite-column:focus-visible {
          outline: 3px solid #4391F5;
          outline-offset: 3px;
        }
        .octane-timer-zone.octane-zone-focused,
        .octane-report-zone.octane-zone-focused {
          background: var(--background);
          border-color: #4391F5;
          border-radius: 14px;
          box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.22);
          box-sizing: border-box;
          display: grid;
          gap: 1rem;
          grid-auto-rows: minmax(0, 1fr);
          grid-auto-flow: row;
          height: auto;
          inset: 1rem;
          max-height: none;
          max-width: none;
          overflow: hidden;
          padding: 1rem;
          position: fixed;
          width: auto;
          z-index: 2147483646;
        }
        .octane-timer-zone.octane-zone-focused {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
        .octane-timer-zone.octane-zone-focused > .octane-chart-card:nth-of-type(3) {
          grid-column: 1;
          grid-row: 2;
        }
        .octane-timer-zone.octane-zone-focused > .octane-chart-card:nth-of-type(4) {
          grid-column: 2;
          grid-row: 2;
        }
        .octane-timer-zone.octane-zone-focused > .octane-chart-card:only-of-type {
          grid-column: 1 / -1;
        }
        .octane-report-zone.octane-zone-focused {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
        .octane-report-zone.octane-zone-focused > .octane-chart-card:nth-of-type(3) {
          grid-column: 1;
          grid-row: 2;
        }
        .octane-report-zone.octane-zone-focused > .octane-chart-card:nth-of-type(4) {
          grid-column: 2;
          grid-row: 2;
        }
        .octane-report-zone.octane-zone-focused > .octane-chart-card:only-of-type {
          grid-column: 1 / -1;
        }
        .octane-zone-focused .octane-chart-card {
          box-sizing: border-box;
          display: flex;
          flex-direction: column;
          height: 100%;
          max-width: 100%;
          min-height: 0;
          min-width: 0;
          padding: clamp(0.55rem, 1vw, 1rem);
          resize: none;
          width: auto;
        }
        .octane-zone-focused .octane-card-header,
        .octane-zone-focused .octane-flip-face-header {
          align-items: flex-start;
          flex: 0 1 auto;
          margin-bottom: clamp(0.25rem, 0.7vh, 0.65rem);
          min-height: 0;
        }
        .octane-zone-focused .octane-card-title {
          font-size: clamp(0.72rem, 1vw, 1rem);
          font-size: clamp(0.66rem, 2.6cqw, 1rem);
          line-height: 1.15;
        }
        .octane-report-zone.octane-zone-focused .octane-card-title {
          font-size: clamp(0.66rem, 2.6cqw, 0.85rem);
        }
        .octane-zone-focused .octane-suite-chart-meta {
          gap: 0.2rem 0.45rem;
        }
        .octane-zone-focused .octane-legend {
          gap: 0.2rem 0.45rem;
        }
        .octane-zone-focused .octane-legend-row,
        .octane-zone-focused .octane-total-label {
          font-size: clamp(0.58rem, 0.85vw, 0.82rem);
          font-size: clamp(0.52rem, 1.9cqw, 0.82rem);
        }
        .octane-report-zone.octane-zone-focused .octane-legend-row,
        .octane-report-zone.octane-zone-focused .octane-total-label {
          font-size: clamp(0.52rem, 1.9cqw, 0.697rem);
        }
        .octane-zone-focused .octane-swatch {
          height: clamp(0.45rem, 0.75vw, 0.7rem);
          width: clamp(0.45rem, 0.75vw, 0.7rem);
        }
        .octane-zone-focused .octane-timer-wrap,
        .octane-zone-focused .octane-flip-viewport,
        .octane-zone-focused .octane-flip-face-body,
        .octane-zone-focused .octane-chart-inner {
          flex: 1 1 auto;
          min-height: 0;
        }
        .octane-zone-focused .octane-donut-graph {
          height: auto;
        }
        .octane-zone-focused .octane-timer-donut {
          height: min(100cqw, 100cqh, 38vh, 38vw);
          max-height: min(38vh, 38vw);
          max-width: min(38vh, 38vw);
          width: min(100cqw, 100cqh, 38vh, 38vw);
        }
        .octane-zone-focused .octane-activity-rings-svg {
          height: min(100cqw, 100cqh, 38vh, 38vw);
          max-height: min(38vh, 38vw);
          max-width: min(38vh, 38vw);
          width: min(100cqw, 100cqh, 38vh, 38vw);
        }
        .octane-zone-focused .octane-timer-wrap {
          height: 100%;
        }
        .octane-zone-focused .octane-risk-heat-map {
          height: min(100cqw, 100cqh, 38vh, 38vw);
          max-height: min(38vh, 38vw);
          max-width: min(38vh, 38vw);
          width: min(100cqw, 100cqh, 38vh, 38vw);
        }
        .octane-zone-focused .octane-bar-graph {
          --octane-axis-label-row: clamp(1.05rem, 2vh, 1.7rem);
          grid-template-columns: clamp(0.85rem, 1.2vw, 1.35rem) max-content minmax(0, 1fr);
          grid-template-rows: minmax(0, 1fr) var(--octane-axis-label-row);
          height: 100%;
          margin-top: clamp(0.25rem, 0.8vh, 0.75rem);
          row-gap: 0;
        }
        .octane-zone-focused .octane-y-axis-label {
          font-size: clamp(0.66rem, 2.1cqw, 0.75rem);
        }
        .octane-zone-focused .octane-axis-value {
          font-size: clamp(0.66rem, 2.1cqw, 0.75rem);
        }
        .octane-zone-focused .octane-suite-label {
          font-size: 12px;
          max-width: 100%;
          padding-top: clamp(0.04rem, 0.25vh, 0.16rem);
        }
        .octane-zone-focused .octane-card-tools {
          cursor: grab;
        }
        .octane-chart-card {
          background: var(--background);
          border: 1px solid var(--input-border);
          border-radius: 14px;
          box-sizing: border-box;
          box-shadow: 0 1px 7px rgba(0, 0, 0, 0.14);
          contain: layout style paint;
          container-type: inline-size;
          flex: 0 1 calc(50% - 0.5rem);
          min-height: 310px;
          min-width: 360px;
          overflow-x: hidden;
          overflow-y: hidden;
          padding: 1rem;
          resize: horizontal;
          width: calc(50% - 0.5rem);
        }
        .octane-chart-card:active {
          cursor: grabbing;
        }
        .octane-card-header {
          align-items: center;
          display: flex;
          gap: clamp(0.35rem, 1.8cqw, 0.75rem);
          justify-content: space-between;
          margin-bottom: clamp(0.35rem, 2cqw, 0.75rem);
        }
        .octane-card-header > div:first-child {
          min-width: 0;
        }
        .octane-card-title {
          font-size: clamp(0.78rem, 1vw, 1rem);
          font-size: clamp(0.72rem, 3.2cqw, 1.08rem);
          font-weight: 600;
          line-height: 1.15;
          margin: 0;
          overflow-wrap: anywhere;
        }
        .octane-card-header .octane-muted,
        .octane-flip-face-header .octane-muted,
        .octane-defect-face-header .octane-muted,
        .octane-total-label,
        .octane-legend-row {
          font-size: clamp(0.62rem, 0.9vw, 0.88rem);
          font-size: clamp(0.58rem, 2.35cqw, 0.9rem);
          line-height: 1.2;
        }
        .octane-report-zone .octane-card-title {
          font-size: clamp(0.72rem, 3.2cqw, 0.918rem);
        }
        .octane-report-zone .octane-card-header .octane-muted,
        .octane-report-zone .octane-total-label,
        .octane-report-zone .octane-legend-row {
          font-size: clamp(0.58rem, 2.35cqw, 0.765rem);
        }
        .octane-card-actions {
          --octane-control-size: 1.15rem;
          align-items: center;
          display: inline-flex;
          flex: 0 0 auto;
          gap: 0.45rem;
        }
        .octane-expand-toggle,
        .octane-client-page-button,
        .octane-view-toggle {
          align-items: center;
          appearance: none;
          background: transparent;
          border: 0;
          border-radius: 4px;
          color: var(--text-color-secondary);
          cursor: pointer;
          display: inline-flex;
          height: var(--octane-control-size);
          justify-content: center;
          padding: 0;
          width: var(--octane-control-size);
        }
        .octane-expand-toggle:hover,
        .octane-client-page-button:hover:not(:disabled),
        .octane-view-toggle:hover {
          background: var(--panel-border-color);
          color: var(--text-color);
        }
        .octane-client-page-button:disabled {
          cursor: default;
          opacity: 0.35;
        }
        .octane-client-page-button[hidden] {
          display: none;
        }
        .octane-action-icon {
          display: block;
          fill: none;
          height: 0.95rem;
          stroke: currentColor;
          stroke-linecap: round;
          stroke-linejoin: round;
          stroke-width: 1.8;
          width: 0.95rem;
        }
        .octane-icon-collapse {
          display: none;
        }
        .octane-icon-timer {
          display: none;
        }
        .octane-chart-card[data-active-view="breakdown"] .octane-icon-breakdown {
          display: none;
        }
        .octane-chart-card[data-active-view="heatmap"] .octane-icon-heatmap {
          display: none;
        }
        .octane-chart-card[data-active-view="metrics"] .octane-icon-metrics {
          display: none;
        }
        .octane-chart-card[data-active-view="defects"] .octane-icon-defects {
          display: none;
        }
        .octane-chart-card[data-active-view="breakdown"] .octane-icon-timer {
          display: block;
        }
        .octane-chart-card[data-active-view="heatmap"] .octane-icon-timer {
          display: block;
        }
        .octane-chart-card[data-active-view="metrics"] .octane-icon-timer {
          display: block;
        }
        .octane-chart-card[data-active-view="defects"] .octane-icon-timer {
          display: block;
        }
        .octane-chart-card[data-card-key="timer-timeout"],
        .octane-chart-card[data-card-key="timer-poll"],
        .octane-chart-card[data-card-key="progress-execution"],
        .octane-chart-card[data-card-key="progress-pass-rate"] {
          display: flex;
          flex-direction: column;
          position: relative;
        }
        .octane-chart-card[data-card-key="timer-poll"][data-active-view="heatmap"] {
          padding-bottom: clamp(0.45rem, 0.8cqw, 0.7rem);
        }
        .octane-chart-card[data-card-key="timer-poll"][data-active-view="heatmap"]
          .octane-flip-viewport {
          min-height: 0;
        }
        .octane-chart-card[data-card-key="timer-timeout"] > .octane-card-actions,
        .octane-chart-card[data-card-key="timer-poll"] > .octane-card-actions,
        .octane-chart-card[data-card-key="progress-execution"] > .octane-card-actions,
        .octane-chart-card[data-card-key="progress-pass-rate"] > .octane-card-actions {
          position: absolute;
          right: 1rem;
          top: 1rem;
          z-index: 3;
        }
        .octane-chart-card[data-card-key="timer-timeout"] {
          container-type: size;
        }
        .octane-flip-viewport {
          box-sizing: border-box;
          display: flex;
          flex: 1 1 auto;
          min-height: 245px;
          min-width: 0;
          overflow: hidden;
          position: relative;
          width: 100%;
        }
        .octane-flip-face {
          box-sizing: border-box;
          display: grid;
          grid-template-rows: auto minmax(0, 1fr);
          inset: 0;
          min-height: 0;
          min-width: 0;
          opacity: 0;
          pointer-events: none;
          position: absolute;
          transform: translateY(0.25rem);
          transition: opacity 160ms ease, transform 160ms ease;
          width: 100%;
        }
        .octane-chart-card[data-active-view="timer"] .octane-flip-face-timer,
        .octane-chart-card[data-active-view="heatmap"] .octane-flip-face-heatmap,
        .octane-chart-card[data-active-view="metrics"] .octane-flip-face-metrics,
        .octane-chart-card[data-active-view="metrics"] .octane-flip-face-management-metrics,
        .octane-chart-card[data-active-view="breakdown"] .octane-flip-face-breakdown,
        .octane-chart-card[data-active-view="defects"] .octane-flip-face-defects {
          opacity: 1;
          pointer-events: auto;
          transform: translateY(0);
        }
        .octane-flip-face-header {
          align-items: flex-start;
          display: flex;
          flex-wrap: wrap;
          gap: 0.35rem 0.75rem;
          justify-content: space-between;
          min-width: 0;
          padding-right: 4.5rem;
        }
        .octane-flip-face-header > div:first-child {
          min-width: 0;
        }
        .octane-flip-face-body {
          align-items: center;
          display: flex;
          justify-content: center;
          min-height: 0;
          min-width: 0;
          overflow: hidden;
          width: 100%;
        }
        .octane-chart-card[data-card-key="timer-poll"][data-active-view="heatmap"]
          .octane-flip-face-body {
          align-items: stretch;
        }
        .octane-chart-card[data-card-key="timer-timeout"][data-active-view="metrics"]
          .octane-flip-face-body {
          align-items: stretch;
          justify-content: stretch;
        }
        .octane-chart-card[data-card-key="timer-timeout"]
          .octane-flip-face-metrics .octane-card-title {
          font-size: clamp(0.78rem, min(3.2cqw, 5cqh), 1.3rem);
        }
        .octane-chart-card[data-card-key="timer-timeout"]
          .octane-flip-face-metrics .octane-muted {
          font-size: clamp(0.58rem, min(2.35cqw, 3.8cqh), 1rem);
        }
        .octane-chart-card[data-card-key="progress-execution"][data-active-view="breakdown"]
          .octane-flip-face-body {
          align-items: stretch;
          justify-content: stretch;
        }
        .octane-chart-card[data-card-key="progress-pass-rate"][data-active-view="defects"]
          .octane-flip-face-body {
          align-items: stretch;
          justify-content: stretch;
        }
        .octane-chart-card[data-card-key="progress-pass-rate"][data-active-view="metrics"]
          .octane-management-metrics-face-body,
        .octane-test-management-defects-card .octane-management-card-body {
          align-items: stretch;
          justify-content: stretch;
        }
        .octane-chart-card[data-card-key="progress-pass-rate"]
          .octane-management-metrics-grid {
          height: 100%;
        }
        .octane-test-management-defects-card .octane-defect-face-header {
          flex: 0 0 auto;
          width: 100%;
        }
        .octane-test-management-defects-card .octane-defect-face-actions {
          margin-left: auto;
        }
        .octane-chart-card[data-card-key="progress-pass-rate"][data-active-view="defects"]
          > .octane-card-actions {
          display: none;
        }
        .octane-execution-breakdown {
          align-items: center;
          box-sizing: border-box;
          container-type: size;
          display: flex;
          height: 100%;
          justify-content: center;
          min-height: 0;
          overflow: hidden;
          padding: clamp(0.2rem, min(1cqh, 1cqw), 0.6rem);
          width: 100%;
        }
        .octane-execution-breakdown-content {
          --octane-execution-chart-height: 50%;
          --octane-execution-content-width: 80rem;
          align-items: center;
          container-type: inline-size;
          display: grid;
          gap: clamp(0.18rem, min(1cqh, 1cqw), 0.7rem);
          grid-template-columns: minmax(0, 1fr);
          grid-template-rows: minmax(0, 1fr) auto;
          height: 100%;
          justify-items: center;
          max-height: 100%;
          max-width: 100%;
          width: min(92cqw, var(--octane-execution-content-width), 80rem);
        }
        .octane-execution-half-pie-wrap {
          align-items: center;
          display: flex;
          height: var(--octane-execution-chart-height);
          justify-content: center;
          min-height: 0;
          min-width: 0;
          width: 100%;
        }
        .octane-execution-half-pie {
          aspect-ratio: 2 / 1;
          display: block;
          height: 100%;
          max-height: 100%;
          max-width: 100%;
          overflow: visible;
          shape-rendering: geometricPrecision;
          width: auto;
        }
        .octane-chart-card[data-card-key="progress-execution"].octane-expanded
          .octane-card-title,
        .octane-timer-zone.octane-zone-focused
          .octane-chart-card[data-card-key="progress-execution"]
          .octane-card-title {
          font-size: clamp(1rem, 2cqw, 1.5rem);
        }
        .octane-chart-card[data-card-key="progress-execution"].octane-expanded
          .octane-muted,
        .octane-timer-zone.octane-zone-focused
          .octane-chart-card[data-card-key="progress-execution"]
          .octane-muted {
          font-size: clamp(0.76rem, 1.35cqw, 1.05rem);
        }
        .octane-execution-half-pie-segment {
          fill: none;
          stroke-linecap: round;
          stroke-linejoin: round;
          stroke-width: 24;
        }
        .octane-execution-half-pie-total {
          fill: var(--text-color);
          font-family: "Hanken Grotesk", Inter, "Segoe UI", Arial, sans-serif;
          font-size: 2.25rem;
          font-weight: 700;
          text-anchor: middle;
        }
        .octane-execution-half-pie-label {
          fill: var(--text-color-secondary);
          font-family: Inter, "Segoe UI", Arial, sans-serif;
          font-size: 0.92rem;
          font-weight: 500;
          text-anchor: middle;
        }
        .octane-execution-breakdown-list {
          box-sizing: border-box;
          display: grid;
          gap: clamp(0.12rem, min(0.72cqw, 0.8cqh), 0.55rem);
          max-width: 100%;
          min-width: 0;
          padding-inline: clamp(0.35rem, 4cqw, 3rem);
          width: 100%;
        }
        .octane-execution-breakdown-row {
          align-items: center;
          color: var(--text-color);
          display: grid;
          font-family: Inter, "Segoe UI", Arial, sans-serif;
          font-size: clamp(0.62rem, min(1.8cqw, 2.4cqh), 1.3rem);
          font-weight: 600;
          gap: clamp(0.4rem, 1cqw, 0.75rem);
          grid-template-columns: clamp(0.55rem, 1.15cqw, 0.9rem) minmax(0, 1fr) max-content;
          line-height: 1.2;
          min-width: 0;
        }
        .octane-execution-breakdown-swatch {
          border-radius: 50%;
          display: inline-block;
          height: clamp(0.55rem, 1.15cqw, 0.9rem);
          width: clamp(0.55rem, 1.15cqw, 0.9rem);
        }
        .octane-execution-breakdown-label {
          min-width: 0;
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;
        }
        .octane-execution-breakdown-metric {
          font-variant-numeric: tabular-nums;
          white-space: nowrap;
        }
        .octane-execution-breakdown-pipe {
          color: var(--text-color-secondary);
          padding: 0 0.16rem;
        }
        .octane-execution-breakdown-empty {
          align-items: center;
          border: 1px dashed var(--input-border);
          border-radius: 8px;
          color: var(--text-color-secondary);
          display: flex;
          height: 100%;
          justify-content: center;
          padding: 1rem;
          text-align: center;
          width: 100%;
        }
        .octane-defect-face-header {
          align-items: flex-start;
          display: flex;
          flex-wrap: nowrap;
          gap: clamp(0.28rem, min(1.1cqw, 1.1cqh), 0.65rem);
          min-width: 0;
          overflow: hidden;
          padding-right: 0;
        }
        .octane-defect-face-heading {
          flex: 1 1 auto;
          min-width: 0;
        }
        .octane-defect-face-heading .octane-card-title,
        .octane-defect-face-heading .octane-muted {
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;
        }
        .octane-defect-face-actions {
          --octane-control-size: 1.15rem;
          align-items: center;
          display: inline-flex;
          flex: 0 0 auto;
          gap: 0.45rem;
          height: var(--octane-control-size);
          max-width: 100%;
          min-width: 0;
          overflow: hidden;
        }
        .octane-defect-main-view-toggle {
          flex: 0 0 var(--octane-control-size);
        }
        .octane-defect-analytics {
          box-sizing: border-box;
          container-type: size;
          display: grid;
          gap: clamp(0.35rem, min(1.4cqw, 1.4cqh), 0.9rem);
          grid-template-rows: minmax(0, 1fr);
          height: 100%;
          min-height: 0;
          min-width: 0;
          padding: clamp(0.15rem, min(0.8cqw, 0.8cqh), 0.5rem);
          width: 100%;
        }
        .octane-defect-pane-switcher {
          align-items: center;
          background: rgba(87, 103, 121, 0.3);
          border: 1px solid rgba(130, 124, 123, 0.32);
          border-radius: 9999px;
          box-sizing: border-box;
          display: inline-flex;
          flex: 0 0 auto;
          gap: 2px;
          height: var(--octane-control-size, 1.15rem);
          min-width: 0;
          overflow: hidden;
          padding: 2px;
          width: auto;
        }
        .octane-defect-pane-toggle {
          align-items: center;
          appearance: none;
          background: transparent;
          border: 0;
          border-radius: 9999px;
          box-sizing: border-box;
          color: var(--text-color-secondary);
          cursor: pointer;
          display: inline-flex;
          flex: 0 0 auto;
          font-family: Inter, "Segoe UI", Arial, sans-serif;
          font-size: clamp(0.52rem, calc(var(--octane-control-size, 1.15rem) * 0.52), 0.68rem);
          font-weight: 600;
          height: 100%;
          justify-content: center;
          line-height: 1;
          min-inline-size: calc(var(--octane-control-size, 1.15rem) * 2.62);
          min-width: 0;
          padding: 0 calc(var(--octane-control-size, 1.15rem) * 0.42);
          text-align: center;
          white-space: nowrap;
        }
        .octane-defect-pane-label-short {
          display: none;
        }
        .octane-defect-pane-toggle[aria-selected="true"] {
          background: rgba(255, 255, 255, 0.12);
          color: var(--text-color);
        }
        .octane-defect-pane-toggle:focus-visible {
          outline: 3px solid #4391F5;
          outline-offset: 2px;
        }
        .octane-defect-pane-viewport {
          height: 100%;
          min-height: 0;
          min-width: 0;
          overflow: hidden;
          position: relative;
          width: 100%;
        }
        .octane-defect-pane {
          box-sizing: border-box;
          display: grid;
          grid-template-rows: minmax(0, 1fr);
          height: 100%;
          inset: 0;
          min-height: 0;
          min-width: 0;
          opacity: 0;
          pointer-events: none;
          position: absolute;
          transform: translateY(0.2rem);
          transition: opacity 160ms ease, transform 160ms ease;
          width: 100%;
        }
        .octane-defect-analytics[data-active-defect-view="volumes"]
          .octane-defect-pane[data-defect-pane="volumes"],
        .octane-defect-analytics[data-active-defect-view="density"]
          .octane-defect-pane[data-defect-pane="density"] {
          opacity: 1;
          pointer-events: auto;
          transform: translateY(0);
        }
        .octane-defect-pane-body {
          align-items: stretch;
          display: flex;
          height: 100%;
          justify-content: stretch;
          min-height: 0;
          min-width: 0;
          overflow: hidden;
          width: 100%;
        }
        .octane-defect-trend {
          align-items: stretch;
          box-sizing: border-box;
          container-type: size;
          display: grid;
          gap: clamp(0.35rem, min(1.3cqw, 1.3cqh), 0.9rem);
          grid-template-columns: minmax(0, 1fr);
          grid-template-rows: max-content minmax(0, 1fr);
          height: 100%;
          min-height: 0;
          min-width: 0;
          width: 100%;
        }
        .octane-defect-trend-summary-card {
          align-content: start;
          background: transparent;
          border: 0;
          box-sizing: border-box;
          display: grid;
          min-height: 0;
          min-width: 0;
          padding: 2px 0;
          width: 100%;
        }
        .octane-defect-trend-totals {
          align-items: start;
          display: flex;
          flex-wrap: wrap;
          gap: clamp(0.65rem, min(3.8cqw, 1.6cqh), 2.4rem);
          min-width: 0;
        }
        .octane-defect-trend-total {
          display: grid;
          min-width: clamp(5rem, 16cqw, 10rem);
        }
        .octane-defect-trend-total[data-visible="false"] {
          display: none;
        }
        .octane-defect-trend-value,
        .octane-defect-density-value {
          font-family: "Hanken Grotesk", Inter, "Segoe UI", Arial, sans-serif;
          font-size: clamp(1.55rem, min(8cqw, 10cqh), 4.8rem);
          font-variant-numeric: tabular-nums;
          font-weight: 700;
          line-height: 0.95;
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;
        }
        .octane-defect-trend-total-opened .octane-defect-trend-value {
          color: #ff6361;
        }
        .octane-defect-trend-total-closed .octane-defect-trend-value {
          color: #7BE5B3;
        }
        .octane-defect-trend-total-label,
        .octane-defect-density-label {
          color: var(--text-color-secondary);
          font-family: Inter, "Segoe UI", Arial, sans-serif;
          font-size: clamp(0.58rem, min(2.4cqw, 2.8cqh), 1rem);
          font-weight: 500;
          line-height: 1.2;
          margin-top: clamp(0.2rem, 0.8cqh, 0.45rem);
        }
        .octane-defect-trend-chart {
          column-gap: clamp(0.16rem, 0.8cqw, 0.45rem);
          display: grid;
          grid-template-columns: max-content max-content minmax(0, 1fr);
          grid-template-rows: minmax(0, 1fr) max-content;
          min-height: 0;
          min-width: 0;
          row-gap: clamp(0.12rem, 0.6cqh, 0.3rem);
        }
        .octane-defect-trend-plot {
          grid-column: 3;
          grid-row: 1;
          min-height: 0;
          min-width: 0;
        }
        .octane-defect-trend-svg {
          display: block;
          height: 100%;
          overflow: visible;
          shape-rendering: geometricPrecision;
          width: 100%;
        }
        .octane-defect-trend-grid-line {
          stroke: #576779;
          stroke-dasharray: 5 7;
          stroke-opacity: 0.58;
          stroke-width: 1;
          vector-effect: non-scaling-stroke;
        }
        .octane-defect-trend-axis-line {
          stroke: #576779;
          stroke-width: 1;
          vector-effect: non-scaling-stroke;
        }
        .octane-defect-trend-axis-label {
          color: #827C7B;
          font-family: Inter, "Segoe UI", Arial, sans-serif;
          font-size: 12px;
          font-size: clamp(0.66rem, 2.1cqw, 0.75rem);
          font-weight: 400;
          line-height: 1;
          white-space: nowrap;
        }
        .octane-defect-trend-axis-title,
        .octane-defect-density-axis-title {
          align-self: center;
          color: #827C7B;
          font-family: Inter, "Segoe UI", Arial, sans-serif;
          font-size: 12px;
          font-size: clamp(0.66rem, 2.1cqw, 0.75rem);
          font-weight: 400;
          grid-column: 1;
          grid-row: 1;
          justify-self: center;
          transform: rotate(180deg);
          white-space: nowrap;
          writing-mode: vertical-rl;
        }
        .octane-defect-trend-y-labels {
          align-items: flex-end;
          display: flex;
          flex-direction: column;
          grid-column: 2;
          grid-row: 1;
          justify-content: space-between;
          min-height: 0;
        }
        .octane-defect-trend-x-labels {
          display: flex;
          grid-column: 3;
          grid-row: 2;
          justify-content: space-between;
          min-width: 0;
        }
        .octane-defect-trend-line {
          fill: none;
          stroke-linecap: round;
          stroke-linejoin: round;
          stroke-width: clamp(2px, 0.28cqw, 4px);
          vector-effect: non-scaling-stroke;
        }
        .octane-defect-trend-line-opened {
          stroke: #ff6361;
        }
        .octane-defect-trend-line-closed {
          stroke: #7BE5B3;
        }
        .octane-defect-trend-points {
          display: none;
        }
        .octane-defect-density {
          box-sizing: border-box;
          container-type: size;
          display: grid;
          gap: clamp(0.35rem, min(1.3cqw, 1.3cqh), 0.9rem);
          grid-template-rows: max-content minmax(0, 1fr);
          height: 100%;
          min-height: 0;
          min-width: 0;
          width: 100%;
        }
        .octane-defect-density-total {
          align-self: start;
          color: var(--text-color);
          display: grid;
          gap: clamp(0.1rem, 0.4cqh, 0.25rem);
          justify-self: start;
          min-width: 0;
          padding: 2px 0;
        }
        .octane-defect-density-value {
          color: #ff6361;
        }
        .octane-defect-density-chart {
          column-gap: clamp(0.22rem, 0.8cqw, 0.55rem);
          display: grid;
          grid-template-columns: max-content max-content minmax(0, 1fr);
          grid-template-rows: minmax(0, 1fr) max-content;
          min-height: 0;
          min-width: 0;
          row-gap: clamp(0.16rem, 0.7cqh, 0.36rem);
        }
        .octane-defect-density-axis-title {
          grid-column: 1;
          grid-row: 1;
        }
        .octane-defect-density-y-labels {
          align-items: flex-end;
          display: flex;
          flex-direction: column;
          grid-column: 2;
          grid-row: 1;
          justify-content: space-between;
          min-height: 0;
        }
        .octane-defect-density-plot {
          grid-column: 3;
          grid-row: 1;
          min-height: 0;
          min-width: 0;
        }
        .octane-defect-density-svg {
          display: block;
          height: 100%;
          overflow: visible;
          shape-rendering: geometricPrecision;
          width: 100%;
        }
        .octane-defect-density-grid-line {
          stroke: #576779;
          stroke-dasharray: 5 7;
          stroke-opacity: 0.58;
          stroke-width: 1;
          vector-effect: non-scaling-stroke;
        }
        .octane-defect-density-axis-line {
          stroke: #576779;
          stroke-width: 1;
          vector-effect: non-scaling-stroke;
        }
        .octane-defect-density-axis-line-dotted {
          stroke-dasharray: 5 7;
          stroke-opacity: 0.58;
        }
        .octane-defect-density-area {
          fill: #3B82F6;
          fill-opacity: 0.76;
          shape-rendering: geometricPrecision;
        }
        .octane-defect-density-line {
          fill: none;
          shape-rendering: geometricPrecision;
          stroke: #3B82F6;
          stroke-linecap: round;
          stroke-linejoin: round;
          stroke-width: 1px;
          vector-effect: non-scaling-stroke;
        }
        .octane-defect-density-x-labels {
          display: flex;
          grid-column: 3;
          grid-row: 2;
          justify-content: space-between;
          min-width: 0;
        }
        .octane-defect-density-axis-label {
          color: #827C7B;
          font-family: Inter, "Segoe UI", Arial, sans-serif;
          font-size: 12px;
          font-size: clamp(0.66rem, 2.1cqw, 0.75rem);
          font-weight: 400;
          line-height: 1;
          white-space: nowrap;
        }
        .octane-defect-density-buckets {
          display: none;
        }
        @container (max-width: 34rem) {
          .octane-defect-face-header {
            gap: calc(var(--octane-control-size, 1.15rem) * 0.24);
          }
          .octane-defect-pane-switcher {
            gap: 1px;
            padding: 1px;
          }
          .octane-defect-pane-toggle {
            min-inline-size: var(--octane-control-size, 1.15rem);
            padding: 0 calc(var(--octane-control-size, 1.15rem) * 0.28);
          }
          .octane-defect-pane-label-full {
            display: none;
          }
          .octane-defect-pane-label-short {
            display: inline;
          }
          .octane-defect-analytics {
            grid-template-rows: minmax(0, 1fr);
          }
          .octane-defect-pane-switcher {
            justify-self: start;
          }
          .octane-defect-trend {
            grid-template-rows: max-content minmax(0, 1fr);
          }
          .octane-defect-trend-summary-card {
            padding: 2px 0;
          }
          .octane-defect-trend-totals {
            gap: clamp(0.45rem, 2cqw, 1rem);
          }
        }
        .octane-heatmap-subtitle-row {
          align-items: center;
          display: flex;
          flex-wrap: wrap;
          gap: 0.24rem 0.45rem;
        }
        .octane-heatmap-inline-legend {
          align-items: center;
          display: inline-flex;
          flex-wrap: wrap;
          gap: 0.24rem 0.45rem;
        }
        .octane-heatmap-inline-legend .octane-legend-row {
          white-space: nowrap;
        }
        .octane-heatmap-inline-legend .octane-swatch {
          height: 0.56rem;
          width: 0.56rem;
        }
        .octane-zone-focused .octane-heatmap-inline-legend .octane-swatch {
          height: clamp(0.32rem, 0.52vw, 0.49rem);
          width: clamp(0.32rem, 0.52vw, 0.49rem);
        }
        .octane-risk-heat-map-panel-inner {
          align-content: stretch;
          align-items: center;
          display: grid;
          gap: clamp(0.35rem, 1vh, 0.65rem);
          grid-template-columns: minmax(0, 1fr);
          grid-template-rows: minmax(0, 1fr) max-content;
          height: 100%;
          justify-items: stretch;
          min-height: 0;
          width: 100%;
        }
        .octane-risk-heat-map-container {
          align-items: center;
          box-sizing: border-box;
          container-type: size;
          display: flex;
          height: 100%;
          justify-content: center;
          min-height: 0;
          overflow: hidden;
          width: 100%;
        }
        .octane-risk-issues-container {
          align-items: center;
          align-self: end;
          box-sizing: border-box;
          display: flex;
          justify-content: center;
          min-width: 0;
          padding-top: clamp(0.2rem, 0.8vh, 0.55rem);
          width: 100%;
        }
        .octane-risk-heat-map {
          aspect-ratio: 1;
          border-radius: 50%;
          box-sizing: border-box;
          clip-path: circle(50% at 50% 50%);
          display: block;
          height: auto;
          height: min(100cqw, 100cqh, 220px);
          max-height: min(100%, 220px);
          max-width: 220px;
          overflow: hidden;
          shape-rendering: geometricPrecision;
          width: min(100%, 220px);
          width: min(100cqw, 100cqh, 220px);
        }
        .octane-risk-heat-map-slice {
          stroke: var(--background);
          stroke-width: 1;
        }
        .octane-risk-heat-map-center {
          fill: var(--background);
          stroke: var(--panel-border-color);
          stroke-width: 1;
        }
        .octane-risk-heat-map-score {
          fill: var(--text-color);
          font-size: 2rem;
          font-weight: 700;
          text-anchor: middle;
        }
        .octane-risk-heat-map-label {
          fill: var(--text-color-secondary);
          font-size: 0.85rem;
          text-anchor: middle;
        }
        .octane-test-metrics-grid {
          box-sizing: border-box;
          display: grid;
          gap: clamp(0.3rem, min(1.8vw, 1.8vh), 1rem);
          grid-template-columns: repeat(2, minmax(0, 1fr));
          grid-template-rows: repeat(2, minmax(0, 1fr));
          height: 100%;
          min-height: 0;
          overflow: hidden;
          width: 100%;
        }
        .octane-test-metric-card {
          --octane-test-metric-bar-label-font-size:
            clamp(0.42rem, min(1.8cqw, 2.1cqh), 0.88rem);
          --octane-test-metric-bar-label-gap:
            clamp(0.32rem, min(2cqw, 2cqh), 1.1rem);
          align-items: stretch;
          background: rgba(48, 54, 61, 0.28);
          border: 1px solid var(--input-border);
          border-radius: 12px;
          box-sizing: border-box;
          container-type: size;
          display: flex;
          flex-direction: column;
          gap: clamp(0.16rem, min(0.9cqw, 0.9cqh), 0.7rem);
          justify-content: flex-start;
          min-height: 0;
          min-width: 0;
          overflow: hidden;
          padding: clamp(0.42rem, min(2.4cqw, 2.4cqh), 1.5rem);
          text-align: center;
        }
        .octane-test-metric-heading {
          align-items: center;
          align-self: flex-start;
          color: var(--text-color);
          display: inline-flex;
          font-family: "JetBrains Mono", "SFMono-Regular", Consolas, monospace;
          font-size: clamp(0.52rem, min(2.25cqw, 2.75cqh), 1.35rem);
          font-weight: 650;
          gap: clamp(0.18rem, min(0.9cqw, 0.9cqh), 0.62rem);
          justify-content: flex-start;
          letter-spacing: 0;
          line-height: 1.1;
          min-width: 0;
          max-width: 100%;
          text-transform: uppercase;
          white-space: nowrap;
        }
        .octane-test-metric-heading span {
          min-width: 0;
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;
        }
        .octane-test-metric-icon {
          fill: none;
          flex: 0 0 auto;
          height: clamp(1.05em, 1.55em, 2em);
          stroke: currentColor;
          stroke-linecap: round;
          stroke-linejoin: round;
          stroke-width: 2;
          width: clamp(1.05em, 1.55em, 2em);
        }
        .octane-test-metric-visual {
          align-items: center;
          display: flex;
          flex: 1 1 auto;
          justify-content: center;
          min-height: 0;
          min-width: 0;
          overflow: hidden;
          width: 100%;
        }
        .octane-test-metric-value {
          box-sizing: border-box;
          color: var(--text-color);
          flex: 0 0 auto;
          font-family: "Hanken Grotesk", Inter, "Segoe UI", Arial, sans-serif;
          font-size: clamp(1.15rem, min(11.5cqw, 17cqh), 5.4rem);
          font-weight: 700;
          letter-spacing: 0;
          line-height: 1.05;
          max-width: 100%;
          overflow: hidden;
          padding-block: 0.06em;
          text-overflow: ellipsis;
          white-space: nowrap;
        }
        .octane-test-metric-gauge {
          align-items: center;
          container-name: octane-test-metric-gauge;
          container-type: size;
          display: flex;
          flex: 1 1 0;
          justify-content: center;
          min-height: 0;
          width: 100%;
        }
        .octane-test-metric-gauge-svg {
          aspect-ratio: 7 / 4;
          display: block;
          flex: 0 1 auto;
          height: auto;
          overflow: visible;
          width: min(92cqw, 175cqh, 28rem);
        }
        .octane-test-metric-gauge-track,
        .octane-test-metric-gauge-fill {
          fill: none;
          stroke-linecap: butt;
          stroke-width: 7;
        }
        .octane-test-metric-gauge-track {
          stroke: rgba(142, 142, 147, 0.42);
          stroke: color-mix(in srgb, var(--text-color-secondary) 42%, transparent);
        }
        .octane-test-metric-gauge-fill {
          stroke: var(--octane-system-green);
        }
        .octane-test-metric-gauge-value {
          fill: var(--text-color);
          font-family: "Hanken Grotesk", Inter, "Segoe UI", Arial, sans-serif;
          font-size: 13px;
          font-weight: 700;
          letter-spacing: 0;
          text-anchor: middle;
        }
        .octane-test-metric-visual-automation,
        .octane-test-metric-visual-progress,
        .octane-test-metric-visual-defects {
          flex-direction: column;
          gap: var(--octane-test-metric-bar-label-gap);
        }
        .octane-test-metric-progress-wrap {
          aspect-ratio: 34 / 1;
          flex: 0 0 auto;
          max-width: 30rem;
          overflow: hidden;
          width: min(82%, 30rem);
        }
        .octane-test-metric-visual-progress::after {
          content: "";
          flex: 0 0 calc(var(--octane-test-metric-bar-label-font-size) * 1.1);
          width: 1px;
        }
        .octane-test-metric-progress {
          appearance: none;
          background: transparent;
          border: 0;
          border-radius: 999px;
          display: block;
          height: 100%;
          overflow: hidden;
          width: 100%;
        }
        .octane-test-metric-progress::-webkit-progress-bar {
          background: rgba(142, 142, 147, 0.38);
          background: color-mix(in srgb, var(--text-color-secondary) 38%, transparent);
          border-radius: 999px;
        }
        .octane-test-metric-progress::-webkit-progress-value {
          background: var(--octane-system-green);
          border-radius: 999px;
        }
        .octane-test-metric-progress::-moz-progress-bar {
          background: var(--octane-system-green);
          border-radius: 999px;
        }
        .octane-test-metric-automation-segments,
        .octane-test-metric-defect-segments {
          display: flex;
          flex: 0 0 auto;
          flex-direction: column;
          gap: var(--octane-test-metric-bar-label-gap);
          max-width: 30rem;
          min-height: 0;
          min-width: 0;
          width: min(82%, 30rem);
        }
        .octane-test-metric-automation-track,
        .octane-test-metric-defect-track {
          aspect-ratio: 34 / 1;
          display: flex;
          gap: 2px;
          min-width: 0;
          width: 100%;
        }
        .octane-test-metric-automation-labels,
        .octane-test-metric-defect-labels {
          display: flex;
          gap: 2px;
          min-height: calc(var(--octane-test-metric-bar-label-font-size) * 1.1);
          min-width: 0;
          width: 100%;
        }
        .octane-test-metric-automation-empty-track,
        .octane-test-metric-defect-empty-track {
          background: rgba(142, 142, 147, 0.38);
          background: color-mix(in srgb, var(--text-color-secondary) 38%, transparent);
          border-radius: 999px;
          display: block;
          height: 100%;
          width: 100%;
        }
        .octane-test-metric-automation-segment,
