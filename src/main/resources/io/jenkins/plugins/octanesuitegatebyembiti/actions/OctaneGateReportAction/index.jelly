<?jelly escape-by-default='true'?>
<j:jelly xmlns:f="/lib/form" xmlns:j="jelly:core" xmlns:l="/lib/layout" xmlns:st="jelly:stapler">
  <l:layout title="${it.displayName}">
    <l:header>
      <st:adjunct includes="css.octane-dashboard" />
    </l:header>
    <l:main-panel>
      <j:set var="snapshot" value="${it.snapshot}" />
      <div class="octane-report">
        <h1>Octane Gate Report</h1>
        <p class="octane-muted octane-report-status" data-report-status="true">
          <span data-report-state-label="true">${snapshot.jobStateLabel}</span>
          <span class="octane-report-status-separator" aria-hidden="true">|</span>
          <span data-report-updated-at="true">
            <j:choose>
              <j:when test="${snapshot.finalizing}">
                Finalizing...
              </j:when>
              <j:when test="${snapshot.building}">
                Status Check In : ${snapshot.refreshCountdownText}
              </j:when>
              <j:otherwise>
                LAST UPDATED: ${snapshot.reconciledAtDateTimeText}
              </j:otherwise>
            </j:choose>
          </span>
        </p>
        <p data-report-message="true">${snapshot.message}</p>
          <div class="octane-exit-extended-form" data-exit-extended-form="true"
            data-visible="${it.extendedExitControlVisible}">
            <f:form method="post" action="exitOctaneAndContinue">
              <span class="octane-exit-extended-command"
                  data-exit-extended-command="true"
                  data-visible="${it.extendedExitAvailable}">
                <button class="jenkins-button jenkins-button--primary octane-exit-extended-button"
                    type="submit">
                  Exit Octane and Continue
                </button>
              </span>
            </f:form>
            <span class="octane-exit-finalizing-status" data-exit-finalizing-status="true"
                data-visible="${it.manualExitPending}" role="status" aria-live="polite">
              Finalizing...
            </span>
          </div>
        <j:if test="${snapshot.hasCriteria()}">
          <p><strong>Criteria:</strong> ${snapshot.criteria}</p>
        </j:if>

        <div class="octane-dashboard octane-card-zone" id="octane-dashboard"
            data-current-updated-at="${snapshot.updatedAt}"
            data-current-updated-at-text="${snapshot.updatedAtDateTimeText}"
            data-job-state-label="${snapshot.jobStateLabel}"
            data-refresh-seconds="${snapshot.refreshSeconds}"
            data-report-building="${snapshot.building}"
            data-report-finalizing="${snapshot.finalizing}"
            data-risk-heat-map-populated="${snapshot.riskHeatMap.populatedData}"
            data-extended-time="${snapshot.extendedTime}"
            data-manual-exit-requested="${it.manualExitRequested}"
            data-manual-exit-requested-at-millis="${it.manualExitRequestedAtMillis}"
            data-snapshot-url="snapshot">
          <div id="octane-reorder-status" class="octane-visually-hidden"
              aria-live="polite" aria-atomic="true"></div>
          <div id="octane-connectivity-status" class="octane-connectivity-status"
              data-state="online" role="status" aria-live="polite" aria-atomic="true"
              hidden="hidden"></div>
          <div class="octane-timer-zone octane-card-zone" id="octane-timer-zone"
              data-zone-key="timers">
            <section class="octane-chart-card octane-timer-card" draggable="true"
                data-card-key="timer-timeout"
                data-octane-timer="timeout"
                data-total-seconds="${snapshot.timeoutSeconds}"
                data-extended-total-seconds="${snapshot.timeoutExtendedSeconds}"
                data-extended-active="${snapshot.extendedTime}"
                data-started-at="${snapshot.startedAt}"
                data-updated-at="${snapshot.updatedAt}"
                data-active="${snapshot.timerActive}"
                data-active-view="timer">
              <div class="octane-card-actions">
                <button class="octane-view-toggle" type="button"
                    data-target-view="metrics" data-target-view-label="test metrics"
                    aria-label="Show test metrics" title="Show test metrics">
                  <svg class="octane-action-icon octane-icon-metrics" viewBox="0 0 24 24"
                      aria-hidden="true" focusable="false">
                    <path d="M4 19V5" />
                    <path d="M4 19h16" />
                    <path d="M8 15h2" />
                    <path d="M12 11h2" />
                    <path d="M16 7h2" />
                  </svg>
                  <svg class="octane-action-icon octane-icon-timer" viewBox="0 0 24 24"
                      aria-hidden="true" focusable="false">
                    <circle cx="12" cy="13" r="8" />
                    <path d="M12 9v4l3 2" />
                    <path d="M9 2h6" />
                  </svg>
                </button>
                <button class="octane-expand-toggle" type="button" aria-label="Expand widget"
                    aria-expanded="false" title="Expand widget">
                  <svg class="octane-action-icon octane-icon-expand" viewBox="0 0 24 24"
                      aria-hidden="true" focusable="false">
                    <path d="M8 4H4v4" />
                    <path d="M16 4h4v4" />
                    <path d="M20 16v4h-4" />
                    <path d="M8 20H4v-4" />
                  </svg>
                  <svg class="octane-action-icon octane-icon-collapse" viewBox="0 0 24 24"
                      aria-hidden="true" focusable="false">
                    <path d="M9 3v6H3" />
                    <path d="M3 9l6-6" />
                    <path d="M15 21v-6h6" />
                    <path d="M21 15l-6 6" />
                  </svg>
                </button>
                <button class="octane-card-tools" type="button"
                    aria-label="Move widget"
                    title="Drag to move. Use arrow keys to reorder. Resize from the corner.">
                  <svg class="octane-grabber-icon" viewBox="0 0 24 24" aria-hidden="true"
                      focusable="false">
                    <circle cx="12" cy="5" r="2" />
                    <circle cx="12" cy="12" r="2" />
                    <circle cx="12" cy="19" r="2" />
                  </svg>
                </button>
              </div>
              <div class="octane-flip-viewport">
                <div class="octane-flip-face octane-flip-face-timer" data-card-view="timer">
                  <div class="octane-flip-face-header">
                    <div>
                      <h2 class="octane-card-title" data-timeout-title="true">
                        ${snapshot.testingTimeTitle}
                      </h2>
                      <div class="octane-muted" data-timeout-subtitle="true">
                        <j:choose>
                          <j:when test="${snapshot.building &amp;&amp; !it.manualExitRequested}">
                            Session Time Remaining
                          </j:when>
                          <j:otherwise>Session Time Spent</j:otherwise>
                        </j:choose>
                      </div>
                    </div>
                  </div>
                  <div class="octane-flip-face-body">
                    <div class="octane-timer-wrap">
                      <svg class="octane-timer-donut" viewBox="0 0 240 240" role="img"
                          aria-label="Testing time remaining">
                        <defs>
                          <linearGradient id="octane-timeout-gradient" x1="32" y1="208" x2="208"
                              y2="32" gradientUnits="userSpaceOnUse">
                            <stop data-timer-tail-stop="true" data-timer-gradient-stop="true"
                                offset="0%" stop-color="#34C759" />
                            <stop data-timer-mid-stop="true" data-timer-gradient-stop="true"
                                offset="50%" stop-color="#34C759" />
                            <stop data-timer-head-stop="true" data-timer-gradient-stop="true"
                                offset="100%" stop-color="#34C759" />
                          </linearGradient>
                        </defs>
                        <circle class="octane-timer-track" cx="120" cy="120" r="84" />
                        <circle class="octane-timer-progress" data-timer-progress="true"
                            cx="120" cy="120" r="84" pathLength="100"
                            stroke="url(#octane-timeout-gradient)"
                            stroke-dasharray="100 100" stroke-linecap="round"
                            transform="rotate(-90 120 120)" />
                        <text class="octane-timer-value" data-timer-value="true" x="120" y="118">
                          --:--
                        </text>
                        <text class="octane-timer-unit octane-timer-unit-full"
                            data-timer-unit="true" x="120" y="132.4">
                          minutes + seconds
                        </text>
                        <text class="octane-timer-unit octane-timer-unit-compact"
                            data-timer-unit-compact="true" x="120" y="132.4">
                          m + s
                        </text>
                      </svg>
                    </div>
                  </div>
                </div>
                <div class="octane-flip-face octane-flip-face-metrics" data-card-view="metrics">
                  <div class="octane-flip-face-header">
                    <div>
                      <h2 class="octane-card-title">Test Insights</h2>
                      <div class="octane-muted">Current Job Analytics</div>
                    </div>
                  </div>
                  <div class="octane-flip-face-body" data-test-metrics-panel="true">
                    <div class="octane-test-metrics-grid">
                      <j:forEach var="metric" items="${snapshot.testMetrics.cards}">
                        <article class="octane-test-metric-card octane-test-metric-${metric.key}"
                            data-test-metric-key="${metric.key}">
                          <div class="octane-test-metric-heading">
                            <j:choose>
                              <j:when test="${metric.icon == 'automation'}">
                                <svg class="octane-test-metric-icon" viewBox="0 0 24 24"
                                    aria-hidden="true">
                                  <path d="M13 2L4 14h7l-1 8 9-12h-7z" />
                                </svg>
                              </j:when>
                              <j:when test="${metric.icon == 'chart'}">
                                <svg class="octane-test-metric-icon" viewBox="0 0 24 24"
                                    aria-hidden="true">
                                  <path d="M4 20h16" />
                                  <path d="M6 16v-5" />
                                  <path d="M12 16V7" />
                                  <path d="M18 16v-9" />
                                </svg>
                              </j:when>
                              <j:when test="${metric.icon == 'activity'}">
                                <svg class="octane-test-metric-icon" viewBox="0 0 24 24"
                                    aria-hidden="true">
                                  <path d="M4 12h4l2-6 4 12 2-6h4" />
                                </svg>
                              </j:when>
                              <j:when test="${metric.icon == 'defect'}">
                                <svg class="octane-test-metric-icon" viewBox="0 0 24 24"
                                    aria-hidden="true">
                                  <path d="M12 3l9 16H3z" />
                                  <path d="M12 9v4" />
                                  <path d="M12 17h.01" />
                                </svg>
                              </j:when>
                              <j:otherwise>
                                <svg class="octane-test-metric-icon" viewBox="0 0 24 24"
                                    aria-hidden="true">
                                  <circle cx="12" cy="13" r="8" />
                                  <path d="M12 9v4l3 2" />
                                  <path d="M9 2h6" />
                                </svg>
                              </j:otherwise>
                            </j:choose>
                            <span>${metric.title}</span>
                          </div>
                          <j:choose>
                            <j:when test="${metric.key == 'automation-usage'}">
                              <div class="octane-test-metric-visual octane-test-metric-visual-automation">
                                <div class="octane-test-metric-value">${metric.value}</div>
                                <div class="octane-test-metric-automation-segments"
                                    data-test-metric-segments="true" role="img"
                                    aria-label="${metric.detail}">
                                  <j:if test="${!metric.segmented}">
                                    <div class="octane-test-metric-automation-track"
                                        aria-hidden="true">
                                      <span class="octane-test-metric-automation-empty-track"></span>
                                    </div>
                                  </j:if>
                                  <j:if test="${metric.segmented}">
                                    <div class="octane-test-metric-automation-track"
                                        aria-hidden="true">
                                      <j:forEach var="segment" items="${metric.segments}">
                                        <span class="octane-test-metric-automation-color octane-test-metric-automation-${segment.severityKey}"
                                            style="--octane-test-metric-segment-share:${segment.percentageText}%"></span>
                                      </j:forEach>
                                    </div>
                                  </j:if>
                                  <div class="octane-test-metric-automation-labels">
                                    <j:forEach var="segment" items="${metric.segments}">
                                      <div class="octane-test-metric-automation-segment"
                                          data-test-metric-segment="true"
                                          data-full-label="${segment.label}"
                                          data-short-label="${segment.shortLabel}"
                                          style="--octane-test-metric-segment-share:${segment.percentageText}%">
                                        <span class="octane-test-metric-segment-label">
                                          ${segment.label}
                                        </span>
                                      </div>
                                    </j:forEach>
                                  </div>
                                </div>
                              </div>
                            </j:when>
                            <j:when test="${metric.key == 'success-rate'}">
                              <div class="octane-test-metric-visual octane-test-metric-gauge">
                                <svg class="octane-test-metric-gauge-svg" viewBox="0 0 84 48"
                                    aria-hidden="true">
                                  <path class="octane-test-metric-gauge-track"
                                      d="M12 42 A30 30 0 0 1 72 42" pathLength="100" />
                                  <path class="octane-test-metric-gauge-fill"
                                      d="M12 42 A30 30 0 0 1 72 42" pathLength="100"
                                      stroke-dasharray="${metric.progressPercentText} 100" />
                                  <text class="octane-test-metric-gauge-value" x="42" y="43">
                                    ${metric.value}
                                  </text>
                                </svg>
                              </div>
                            </j:when>
                            <j:when test="${metric.key == 'execution'}">
                              <div class="octane-test-metric-visual octane-test-metric-visual-progress">
                                <div class="octane-test-metric-value">${metric.value}</div>
                                <div class="octane-test-metric-progress-wrap">
                                  <progress class="octane-test-metric-progress" max="100"
                                      value="${metric.progressPercentText}"
                                      aria-label="${metric.title} ${metric.value}"></progress>
                                </div>
                              </div>
                            </j:when>
                            <j:when test="${metric.key == 'defects'}">
                              <div class="octane-test-metric-visual octane-test-metric-visual-defects">
                                <div class="octane-test-metric-value">${metric.value}</div>
                                <div class="octane-test-metric-defect-segments"
                                    data-test-metric-segments="true">
                                  <j:if test="${!metric.segmented}">
                                    <div class="octane-test-metric-defect-track" aria-hidden="true">
                                      <span class="octane-test-metric-defect-empty-track"></span>
                                    </div>
                                  </j:if>
                                  <j:if test="${metric.segmented}">
                                    <div class="octane-test-metric-defect-track" aria-hidden="true">
                                      <j:forEach var="segment" items="${metric.segments}">
                                        <span class="octane-test-metric-defect-color octane-test-metric-defect-color-${segment.severityKey}"
                                            style="--octane-test-metric-segment-share:${segment.percentageText}%"></span>
                                      </j:forEach>
                                    </div>
                                  </j:if>
                                  <div class="octane-test-metric-defect-labels">
                                    <j:forEach var="segment" items="${metric.segments}">
                                      <div class="octane-test-metric-defect-segment"
                                          data-test-metric-segment="true"
                                          data-full-label="${segment.label}"
                                          data-short-label="${segment.shortLabel}"
                                          style="--octane-test-metric-segment-share:${segment.percentageText}%">
                                        <span class="octane-test-metric-defect-label">
                                          ${segment.label}
                                        </span>
                                      </div>
                                    </j:forEach>
                                  </div>
                                </div>
                              </div>
                            </j:when>
                            <j:otherwise>
                              <div class="octane-test-metric-value">${metric.value}</div>
                            </j:otherwise>
                          </j:choose>
                          <div class="octane-test-metric-detail">${metric.detail}</div>
                          <div class="octane-test-metric-trend octane-test-metric-trend-${metric.trendTone}">
                            ${metric.trendText}
                          </div>
                        </article>
                      </j:forEach>
                    </div>
                  </div>
                </div>
              </div>
            </section>

            <section class="octane-chart-card octane-timer-card" draggable="true"
                data-card-key="timer-poll"
                data-octane-timer="poll"
                data-total-seconds="${snapshot.refreshSeconds}"
                data-started-at="${snapshot.updatedAt}"
                data-updated-at="${snapshot.updatedAt}"
                data-active="${snapshot.timerActive}"
                data-active-view="timer">
              <div class="octane-card-actions">
                <j:if test="${snapshot.riskHeatMapEnabled}">
                  <button class="octane-view-toggle" type="button"
                      data-target-view="heatmap" data-target-view-label="risk heat map"
                      aria-label="Show risk heat map" title="Show risk heat map">
                    <svg class="octane-action-icon octane-icon-heatmap" viewBox="0 0 24 24"
                        aria-hidden="true" focusable="false">
                      <path d="M4 4h6v6H4z" />
                      <path d="M14 4h6v6h-6z" />
                      <path d="M4 14h6v6H4z" />
                      <path d="M14 14h6v6h-6z" />
                    </svg>
                    <svg class="octane-action-icon octane-icon-timer" viewBox="0 0 24 24"
                        aria-hidden="true" focusable="false">
                      <circle cx="12" cy="13" r="8" />
                      <path d="M12 9v4l3 2" />
                      <path d="M9 2h6" />
                    </svg>
                  </button>
                </j:if>
                <button class="octane-expand-toggle" type="button" aria-label="Expand widget"
                    aria-expanded="false" title="Expand widget">
                  <svg class="octane-action-icon octane-icon-expand" viewBox="0 0 24 24"
                      aria-hidden="true" focusable="false">
                    <path d="M8 4H4v4" />
                    <path d="M16 4h4v4" />
                    <path d="M20 16v4h-4" />
                    <path d="M8 20H4v-4" />
                  </svg>
                  <svg class="octane-action-icon octane-icon-collapse" viewBox="0 0 24 24"
                      aria-hidden="true" focusable="false">
                    <path d="M9 3v6H3" />
                    <path d="M3 9l6-6" />
                    <path d="M15 21v-6h6" />
                    <path d="M21 15l-6 6" />
                  </svg>
                </button>
                <button class="octane-card-tools" type="button"
                    aria-label="Move widget"
                    title="Drag to move. Use arrow keys to reorder. Resize from the corner.">
                  <svg class="octane-grabber-icon" viewBox="0 0 24 24" aria-hidden="true"
                      focusable="false">
                    <circle cx="12" cy="5" r="2" />
                    <circle cx="12" cy="12" r="2" />
                    <circle cx="12" cy="19" r="2" />
                  </svg>
                </button>
              </div>
              <div class="octane-flip-viewport">
                <div class="octane-flip-face octane-flip-face-timer" data-card-view="timer">
                  <div class="octane-flip-face-header">
                    <div class="octane-activity-header-copy">
                      <h2 class="octane-card-title">Execution Activity Rings</h2>
                      <div class="octane-muted octane-activity-subtitle">
                        <span class="octane-activity-inline-legend"
                            data-activity-inline-legend="true"
                            aria-label="Execution Rate ${snapshot.executionProgressTwoDecimalText} Pass Rate ${snapshot.passRateProgressTwoDecimalText} Automation Usage ${snapshot.automationProgressTwoDecimalText}">
                          <span class="octane-activity-legend-item">
                            <span class="octane-activity-ring-swatch octane-activity-ring-execution"
                                aria-hidden="true"></span>
                            <span class="octane-activity-legend-full">Execution Rate</span>
                            <span class="octane-activity-legend-compact" aria-hidden="true">Execution</span>
                            (<span data-activity-rate="execution">${snapshot.executionProgressTwoDecimalText}</span>)
                          </span>
                          <span class="octane-activity-legend-item">
                            <span class="octane-activity-ring-swatch octane-activity-ring-pass"
                                aria-hidden="true"></span>
                            <span class="octane-activity-legend-full">Pass Rate</span>
                            <span class="octane-activity-legend-compact" aria-hidden="true">Pass</span>
                            (<span data-activity-rate="pass">${snapshot.passRateProgressTwoDecimalText}</span>)
                          </span>
                          <span class="octane-activity-legend-item">
                            <span class="octane-activity-ring-swatch octane-activity-ring-automation"
                                aria-hidden="true"></span>
                            <span class="octane-activity-legend-full">Automation Usage</span>
                            <span class="octane-activity-legend-compact" aria-hidden="true">Automation</span>
                            (<span data-activity-rate="automation">${snapshot.automationProgressTwoDecimalText}</span>)
                          </span>
                        </span>
                      </div>
                    </div>
                  </div>
                  <div class="octane-flip-face-body">
                    <div class="octane-activity-rings" data-activity-rings="true"
                        data-side-legend-visible="false"
                        data-activity-value-execution="${snapshot.executionProgress}"
                        data-activity-value-pass="${snapshot.passRateProgress}"
                        data-activity-value-automation="${snapshot.testMetrics.automationPercentage}">
                      <div class="octane-activity-rings-layout">
                        <div class="octane-activity-rings-graphic">
                          <svg class="octane-activity-rings-svg" viewBox="0 0 240 240" role="img"
                              aria-label="Execution rate ${snapshot.executionProgressTwoDecimalText}, pass rate ${snapshot.passRateProgressTwoDecimalText}, automation usage ${snapshot.automationProgressTwoDecimalText}">
                            <circle class="octane-activity-ring-track octane-activity-ring-execution"
                                cx="120" cy="120" r="84" pathLength="100" />
                            <circle class="octane-activity-ring-progress octane-activity-ring-execution"
                                data-activity-ring="execution" cx="120" cy="120" r="84"
                                pathLength="100" stroke-dasharray="${snapshot.executionProgress} 100"
                                transform="rotate(-90 120 120)" />
                            <circle class="octane-activity-ring-track octane-activity-ring-pass"
                                cx="120" cy="120" r="64.5" pathLength="100" />
                            <circle class="octane-activity-ring-progress octane-activity-ring-pass"
                                data-activity-ring="pass" cx="120" cy="120" r="64.5"
                                pathLength="100" stroke-dasharray="${snapshot.passRateProgress} 100"
                                transform="rotate(-90 120 120)" />
                            <circle class="octane-activity-ring-track octane-activity-ring-automation"
                                cx="120" cy="120" r="45" pathLength="100" />
                            <circle class="octane-activity-ring-progress octane-activity-ring-automation"
                                data-activity-ring="automation" cx="120" cy="120" r="45"
                                pathLength="100"
                                stroke-dasharray="${snapshot.testMetrics.automationPercentage} 100"
                                transform="rotate(-90 120 120)" />
                          </svg>
                        </div>
                        <table class="octane-activity-side-legend">
                          <caption>Execution activity rates</caption>
                          <tbody>
                            <tr>
                              <th scope="row">
                                <span class="octane-activity-side-legend-label">
                                  <span class="octane-activity-ring-swatch octane-activity-ring-execution"
                                      aria-hidden="true"></span>
                                  Execution Rate
                                </span>
                              </th>
                              <td data-activity-rate="execution">${snapshot.executionProgressTwoDecimalText}</td>
                            </tr>
                            <tr>
                              <th scope="row">
                                <span class="octane-activity-side-legend-label">
                                  <span class="octane-activity-ring-swatch octane-activity-ring-pass"
                                      aria-hidden="true"></span>
                                  Pass Rate
                                </span>
                              </th>
                              <td data-activity-rate="pass">${snapshot.passRateProgressTwoDecimalText}</td>
                            </tr>
                            <tr>
                              <th scope="row">
                                <span class="octane-activity-side-legend-label">
                                  <span class="octane-activity-ring-swatch octane-activity-ring-automation"
                                      aria-hidden="true"></span>
                                  Automation Usage
                                </span>
                              </th>
                              <td data-activity-rate="automation">${snapshot.automationProgressTwoDecimalText}</td>
                            </tr>
                          </tbody>
                        </table>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="octane-flip-face octane-flip-face-heatmap" data-card-view="heatmap">
                  <div class="octane-flip-face-header">
                    <div>
                      <h2 class="octane-card-title">Risk Heat Map</h2>
                      <div class="octane-muted octane-heatmap-subtitle-row">
                        <span class="octane-heatmap-inline-legend">
                          <span class="octane-legend-row">
                            <span class="octane-swatch" style="background:#009900"></span>Low
                          </span>
                          <span class="octane-legend-row">
                            <span class="octane-swatch" style="background:#4391F5"></span>Moderate
                          </span>
                          <span class="octane-legend-row">
                            <span class="octane-swatch" style="background:#ffb74d"></span>Warning
                          </span>
                          <span class="octane-legend-row">
                            <span class="octane-swatch" style="background:#990000"></span>High
                          </span>
                        </span>
                      </div>
                    </div>
                  </div>
                  <div class="octane-flip-face-body" data-heat-map-panel="true">
                    <div class="octane-risk-heat-map-empty">
                      <j:choose>
                        <j:when test="${snapshot.riskHeatMapEnabled}">
                          Risk heat map will appear after the next report refresh.
                        </j:when>
                        <j:otherwise>
                          Risk heat map is disabled. Set riskHeatMap: true to fetch defect risk data.
                        </j:otherwise>
                      </j:choose>
                    </div>
                  </div>
                </div>
              </div>
            </section>

            <section class="octane-chart-card octane-timer-card" draggable="true"
                data-card-key="progress-execution"
                data-octane-progress="completion"
                data-progress-value="${snapshot.completionProgress}"
                data-active-view="timer">
              <div class="octane-card-actions">
                <button class="octane-view-toggle" type="button"
                    data-target-view="breakdown" data-target-view-label="status breakdown"
                    aria-label="Show status breakdown" title="Show status breakdown">
                  <svg class="octane-action-icon octane-icon-breakdown" viewBox="0 0 24 24"
                      aria-hidden="true" focusable="false">
                    <path d="M5 17a7 7 0 0 1 14 0" />
                    <path d="M8 17a4 4 0 0 1 8 0" />
                    <path d="M12 17v-4" />
                  </svg>
                  <svg class="octane-action-icon octane-icon-timer" viewBox="0 0 24 24"
                      aria-hidden="true" focusable="false">
                    <circle cx="12" cy="13" r="8" />
                    <path d="M12 9v4l3 2" />
                    <path d="M9 2h6" />
                  </svg>
                </button>
                <button class="octane-expand-toggle" type="button" aria-label="Expand widget"
                    aria-expanded="false" title="Expand widget">
                  <svg class="octane-action-icon octane-icon-expand" viewBox="0 0 24 24"
                      aria-hidden="true" focusable="false">
                    <path d="M8 4H4v4" />
                    <path d="M16 4h4v4" />
                    <path d="M20 16v4h-4" />
                    <path d="M8 20H4v-4" />
                  </svg>
                  <svg class="octane-action-icon octane-icon-collapse" viewBox="0 0 24 24"
                      aria-hidden="true" focusable="false">
                    <path d="M9 3v6H3" />
                    <path d="M3 9l6-6" />
                    <path d="M15 21v-6h6" />
                    <path d="M21 15l-6 6" />
                  </svg>
                </button>
                <button class="octane-card-tools" type="button"
                    aria-label="Move widget"
                    title="Drag to move. Use arrow keys to reorder. Resize from the corner.">
                  <svg class="octane-grabber-icon" viewBox="0 0 24 24" aria-hidden="true"
                      focusable="false">
                    <circle cx="12" cy="5" r="2" />
                    <circle cx="12" cy="12" r="2" />
                    <circle cx="12" cy="19" r="2" />
                  </svg>
                </button>
              </div>
              <div class="octane-flip-viewport">
                <div class="octane-flip-face octane-flip-face-timer" data-card-view="timer">
                  <div class="octane-flip-face-header">
                    <div>
                      <h2 class="octane-card-title">Execution Progress</h2>
                      <div class="octane-muted">All Testcase completion</div>
                    </div>
                  </div>
                  <div class="octane-flip-face-body">
                    <div class="octane-timer-wrap">
                      <svg class="octane-timer-donut" viewBox="0 0 240 240" role="img"
                          aria-label="Execution Progress">
                        <defs>
                          <linearGradient id="octane-execution-progress-gradient" x1="32" y1="208"
                              x2="208" y2="32" gradientUnits="userSpaceOnUse">
                            <stop data-execution-gradient-stop="true" offset="0%"
                                stop-color="#FF3B30" />
                            <stop data-execution-gradient-stop="true" offset="50%"
                                stop-color="#FF3B30" />
                            <stop data-execution-gradient-stop="true" offset="100%"
                                stop-color="#FF3B30" />
                          </linearGradient>
                        </defs>
                        <circle class="octane-timer-track" cx="120" cy="120" r="84" />
                        <circle class="octane-timer-progress"
                            data-execution-progress-circle="true" data-progress-circle="true"
                            cx="120" cy="120" r="84" pathLength="100"
                            stroke="url(#octane-execution-progress-gradient)"
                            stroke-dasharray="0 100" stroke-linecap="round"
                            transform="rotate(-90 120 120)" />
                        <text class="octane-timer-value" data-execution-progress-value="true"
                            data-progress-value-text="true" x="120" y="118">
                          ${snapshot.completionProgressText}
                        </text>
                        <text class="octane-timer-unit" x="120" y="132.4">
                          completion
                        </text>
                      </svg>
                    </div>
                  </div>
                </div>
                <div class="octane-flip-face octane-flip-face-breakdown"
                    data-card-view="breakdown">
                  <div class="octane-flip-face-header">
                    <div>
                      <h2 class="octane-card-title">Execution Progress</h2>
                      <div class="octane-muted">All Testcase Status</div>
                    </div>
                  </div>
                  <div class="octane-flip-face-body" data-execution-breakdown-panel="true">
                    <div class="octane-execution-breakdown">
                      <j:choose>
                        <j:when test="${snapshot.executionStatusDistribution.total == 0}">
                          <div class="octane-execution-breakdown-empty">
                            Execution status distribution will appear after Octane returns test runs.
                          </div>
                        </j:when>
                        <j:otherwise>
                          <div class="octane-execution-breakdown-content"
                              data-status-count="${snapshot.executionStatusDistribution.statusCount}">
                            <div class="octane-execution-half-pie-wrap">
                              <svg class="octane-execution-half-pie" viewBox="0 36 320 160"
                                  preserveAspectRatio="xMidYMid meet" role="img"
                                  aria-label="Execution status distribution">
                              <j:forEach var="segment"
                                  items="${snapshot.executionStatusDistribution.segments}">
                                <path class="octane-execution-half-pie-segment"
                                    d="${segment.path}" stroke="${segment.color}">
                                  <title>${segment.title}</title>
                                </path>
                              </j:forEach>
                              <text class="octane-execution-half-pie-total" x="160" y="146">
                                ${snapshot.executionStatusDistribution.total}
                              </text>
                              <text class="octane-execution-half-pie-label" x="160" y="172">
                                Testcases
                              </text>
                              </svg>
                            </div>
                            <div class="octane-execution-breakdown-list">
                              <j:forEach var="segment"
                                  items="${snapshot.executionStatusDistribution.segments}">
                                <div class="octane-execution-breakdown-row">
                                  <span class="octane-execution-breakdown-swatch"
                                      style="background:${segment.color};"></span>
                                  <span class="octane-execution-breakdown-label">
                                    ${segment.label}
                                  </span>
                                  <span class="octane-execution-breakdown-metric">
                                    ${segment.count}
                                    <span class="octane-execution-breakdown-pipe">|</span>
                                    ${segment.percentageLabel}
                                  </span>
                                </div>
                              </j:forEach>
                            </div>
                          </div>
                        </j:otherwise>
                      </j:choose>
                    </div>
                  </div>
                </div>
              </div>
            </section>

            <section class="octane-chart-card octane-timer-card" draggable="true"
                data-card-key="progress-pass-rate"
                data-octane-progress="pass-rate"
                data-progress-value="${snapshot.passRateProgress}"
                data-active-view="timer">
              <div class="octane-card-actions">
                <button class="octane-view-toggle octane-view-toggle-root" type="button"
                    data-target-view="metrics" data-target-view-label="QA health and compliance"
                    aria-label="Show QA health and compliance"
                    title="Show QA health and compliance">
                  <svg class="octane-action-icon octane-icon-metrics" viewBox="0 0 24 24"
                      aria-hidden="true" focusable="false">
                    <path d="M4 19V5" />
                    <path d="M4 19h16" />
                    <path d="M8 15h2" />
                    <path d="M12 11h2" />
                    <path d="M16 7h2" />
                  </svg>
                  <svg class="octane-action-icon octane-icon-timer" viewBox="0 0 24 24"
                      aria-hidden="true" focusable="false">
                    <circle cx="12" cy="13" r="8" />
                    <path d="M12 9v4l3 2" />
                    <path d="M9 2h6" />
                  </svg>
                </button>
                <button class="octane-expand-toggle" type="button" aria-label="Expand widget"
                    aria-expanded="false" title="Expand widget">
                  <svg class="octane-action-icon octane-icon-expand" viewBox="0 0 24 24"
                      aria-hidden="true" focusable="false">
                    <path d="M8 4H4v4" />
                    <path d="M16 4h4v4" />
                    <path d="M20 16v4h-4" />
                    <path d="M8 20H4v-4" />
                  </svg>
                  <svg class="octane-action-icon octane-icon-collapse" viewBox="0 0 24 24"
                      aria-hidden="true" focusable="false">
                    <path d="M9 3v6H3" />
                    <path d="M3 9l6-6" />
                    <path d="M15 21v-6h6" />
                    <path d="M21 15l-6 6" />
                  </svg>
                </button>
                <button class="octane-card-tools" type="button"
                    aria-label="Move widget"
                    title="Drag to move. Use arrow keys to reorder. Resize from the corner.">
                  <svg class="octane-grabber-icon" viewBox="0 0 24 24" aria-hidden="true"
                      focusable="false">
                    <circle cx="12" cy="5" r="2" />
                    <circle cx="12" cy="12" r="2" />
                    <circle cx="12" cy="19" r="2" />
                  </svg>
                </button>
              </div>
              <div class="octane-flip-viewport">
                <div class="octane-flip-face octane-flip-face-timer" data-card-view="timer">
                  <div class="octane-flip-face-header">
                    <div>
                      <h2 class="octane-card-title">Execution Pass Rate</h2>
                      <div class="octane-muted" data-pass-rate-label="true">
                        ${snapshot.passRateLabel}
                      </div>
                    </div>
                  </div>
                  <div class="octane-flip-face-body">
                    <div class="octane-timer-wrap">
                      <svg class="octane-timer-donut" viewBox="0 0 240 240" role="img"
                          aria-label="Execution Pass Rate">
                        <defs>
                          <linearGradient id="octane-pass-rate-progress-gradient" x1="32" y1="208"
                              x2="208" y2="32" gradientUnits="userSpaceOnUse">
                            <stop data-progress-gradient-stop="true" offset="0%"
                                stop-color="#FF3B30" />
                            <stop data-progress-gradient-stop="true" offset="50%"
                                stop-color="#FF3B30" />
                            <stop data-progress-gradient-stop="true" offset="100%"
                                stop-color="#FF3B30" />
                          </linearGradient>
                        </defs>
                        <circle class="octane-timer-track" cx="120" cy="120" r="84" />
                        <circle class="octane-timer-progress" data-progress-circle="true"
                            cx="120" cy="120" r="84" pathLength="100"
                            stroke="url(#octane-pass-rate-progress-gradient)"
                            stroke-dasharray="0 100" stroke-linecap="round"
                            transform="rotate(-90 120 120)" />
                        <text class="octane-timer-value" data-progress-value-text="true"
                            x="120" y="118">
                          ${snapshot.passRateProgressText}
                        </text>
                        <text class="octane-timer-unit" x="120" y="132.4">
                          passed
                        </text>
                      </svg>
                    </div>
                  </div>
                </div>
                <div class="octane-flip-face octane-flip-face-defects"
                    data-card-view="defects">
                  <div class="octane-defect-face-header">
                    <div class="octane-defect-face-heading">
                      <h2 class="octane-card-title" data-defect-view-title="true">
                        Execution Defect Rate
                      </h2>
                      <div class="octane-muted" data-defect-view-subtitle="true">
                        Defect Arrival vs. Resolution Trend Analysis
                      </div>
                    </div>
                    <div class="octane-defect-pane-switcher" role="tablist"
                      aria-label="Defect analytics view">
                      <button class="octane-defect-pane-toggle" type="button" role="tab"
                          aria-selected="true" data-defect-target-view="volumes"
                          data-defect-title="Execution Defect Rate"
                          data-defect-subtitle="Defect Arrival vs. Resolution Trend Analysis">
                        <span class="octane-defect-pane-label-full">Volume</span>
                        <span class="octane-defect-pane-label-short">V</span>
                      </button>
                      <button class="octane-defect-pane-toggle" type="button" role="tab"
                          aria-selected="false" data-defect-target-view="density"
                          data-defect-title="Defect Density"
                          data-defect-subtitle="Execution Defect Density">
                        <span class="octane-defect-pane-label-full">Density</span>
                        <span class="octane-defect-pane-label-short">D</span>
                      </button>
                    </div>
                    <div class="octane-card-actions octane-defect-face-actions">
                      <button class="octane-view-toggle octane-defect-main-view-toggle"
                          type="button" data-target-view="defects"
                          data-target-view-label="execution defect rate"
                          aria-label="Show timer" title="Show timer">
                        <svg class="octane-action-icon octane-icon-defects" viewBox="0 0 24 24"
                            aria-hidden="true" focusable="false">
                          <path d="M4 18l4-5 4 2 4-8 4 3" />
                          <path d="M4 20h16" />
                        </svg>
                        <svg class="octane-action-icon octane-icon-timer" viewBox="0 0 24 24"
                            aria-hidden="true" focusable="false">
                          <circle cx="12" cy="13" r="8" />
                          <path d="M12 9v4l3 2" />
                          <path d="M9 2h6" />
                        </svg>
                      </button>
                      <button class="octane-expand-toggle" type="button"
                          aria-label="Expand widget" aria-expanded="false"
                          title="Expand widget">
                        <svg class="octane-action-icon octane-icon-expand" viewBox="0 0 24 24"
                            aria-hidden="true" focusable="false">
                          <path d="M8 4H4v4" />
                          <path d="M16 4h4v4" />
                          <path d="M20 16v4h-4" />
                          <path d="M8 20H4v-4" />
                        </svg>
                        <svg class="octane-action-icon octane-icon-collapse" viewBox="0 0 24 24"
                            aria-hidden="true" focusable="false">
                          <path d="M9 3v6H3" />
                          <path d="M3 9l6-6" />
                          <path d="M15 21v-6h6" />
                          <path d="M21 15l-6 6" />
                        </svg>
                      </button>
                      <button class="octane-card-tools" type="button"
                          aria-label="Move widget"
                          title="Drag to move. Use arrow keys to reorder. Resize from the corner.">
                        <svg class="octane-grabber-icon" viewBox="0 0 24 24"
                            aria-hidden="true" focusable="false">
                          <circle cx="12" cy="5" r="2" />
                          <circle cx="12" cy="12" r="2" />
                          <circle cx="12" cy="19" r="2" />
                        </svg>
                      </button>
                    </div>
                  </div>
                  <div class="octane-flip-face-body">
                    <div class="octane-defect-analytics" data-defect-analytics="true"
                        data-active-defect-view="volumes">
                      <div class="octane-defect-pane-viewport">
                        <div class="octane-defect-pane" data-defect-pane="volumes" role="tabpanel">
                          <div class="octane-defect-pane-body">
                            <div class="octane-defect-trend" data-defect-trend-panel="true"
                                data-started-at="${snapshot.defectTrend.startedAt}"
                                data-duration-millis="${snapshot.defectTrend.durationMillis}"
                                data-building="${snapshot.building}">
                              <div class="octane-defect-trend-summary-card">
                                <div class="octane-defect-trend-totals">
                                  <div class="octane-defect-trend-total octane-defect-trend-total-opened">
                                    <div class="octane-defect-trend-value"
                                        data-defect-trend-open-total="true">
                                      ${snapshot.defectTrend.openTotal}
                                    </div>
                                    <div class="octane-defect-trend-total-label">Open Defects</div>
                                  </div>
                                  <div class="octane-defect-trend-total octane-defect-trend-total-closed"
                                      data-defect-trend-closed="true"
                                      data-visible="${snapshot.defectTrend.openedTotal > 0}">
                                    <div class="octane-defect-trend-value"
                                        data-defect-trend-closed-total="true">
                                      ${snapshot.defectTrend.closedTotal}
                                    </div>
                                    <div class="octane-defect-trend-total-label">Closed Defects</div>
                                  </div>
                                </div>
                              </div>
                              <div class="octane-defect-trend-chart">
                                <div class="octane-defect-trend-axis-title">Defects</div>
                                <div class="octane-defect-trend-y-labels"
                                    data-defect-trend-y-labels="true"></div>
                                <div class="octane-defect-trend-plot">
                                  <svg class="octane-defect-trend-svg" viewBox="0 0 1000 434"
                                      preserveAspectRatio="none" role="img"
                                      aria-labelledby="octane-defect-trend-title octane-defect-trend-description">
                                    <title id="octane-defect-trend-title">Defects raised and closed over time</title>
                                    <desc id="octane-defect-trend-description">
                                      Red tracks all defects raised. Green tracks closed defects.
                                    </desc>
                                    <g data-defect-trend-grid="true"></g>
                                    <line class="octane-defect-trend-axis-line" x1="0" y1="434"
                                        x2="1000" y2="434" />
                                    <path class="octane-defect-trend-line octane-defect-trend-line-opened"
                                        data-defect-trend-opened-line="true" d="" />
                                    <path class="octane-defect-trend-line octane-defect-trend-line-closed"
                                        data-defect-trend-closed-line="true" d="" />
                                  </svg>
                                </div>
                                <div class="octane-defect-trend-x-labels"
                                    data-defect-trend-x-labels="true"></div>
                              </div>
                              <div class="octane-defect-trend-points" aria-hidden="true">
                                <j:forEach var="point" items="${snapshot.defectTrend.points}">
                                  <span data-defect-trend-point="true"
                                      data-elapsed-millis="${point.elapsedMillis}"
                                      data-opened="${point.opened}" data-closed="${point.closed}"
                                      data-executed="${point.executed}"></span>
                                </j:forEach>
                              </div>
                            </div>
                          </div>
                        </div>
                        <div class="octane-defect-pane" data-defect-pane="density" role="tabpanel">
                          <div class="octane-defect-pane-body">
                            <div class="octane-defect-density" data-defect-density-panel="true"
                                data-started-at="${snapshot.defectTrend.startedAt}"
                                data-duration-millis="${snapshot.defectTrend.durationMillis}">
                              <div class="octane-defect-density-total">
                                <div class="octane-defect-density-value"
                                    data-defect-density-raised-total="true">
                                  ${snapshot.defectTrend.raisedTotal}
                                </div>
                                <div class="octane-defect-density-label">Defects Raised</div>
                              </div>
                              <div class="octane-defect-density-chart">
                                <div class="octane-defect-density-axis-title">Defects / Test</div>
                                <div class="octane-defect-density-y-labels"
                                    data-defect-density-y-labels="true"></div>
                                <div class="octane-defect-density-plot">
                                  <svg class="octane-defect-density-svg" viewBox="0 0 1000 360"
                                      preserveAspectRatio="none" role="img"
                                      aria-labelledby="octane-defect-density-title octane-defect-density-description">
                                    <title id="octane-defect-density-title">Defect density over execution time</title>
                                    <desc id="octane-defect-density-description">
                                      Blue tracks new defects divided by tests executed in each interval.
                                    </desc>
                                    <g data-defect-density-grid="true"></g>
                                    <line class="octane-defect-density-axis-line octane-defect-density-axis-line-dotted"
                                        x1="0" y1="360" x2="80" y2="360" />
                                    <line class="octane-defect-density-axis-line"
                                        x1="80" y1="360" x2="920" y2="360" />
                                    <line class="octane-defect-density-axis-line octane-defect-density-axis-line-dotted"
                                        x1="920" y1="360" x2="1000" y2="360" />
                                    <path class="octane-defect-density-area"
                                        data-defect-density-area="true"
                                        shape-rendering="geometricPrecision" d="" />
                                    <path class="octane-defect-density-line"
                                        data-defect-density-line="true"
                                        shape-rendering="geometricPrecision" stroke-width="1"
                                        d="" />
                                  </svg>
                                </div>
                                <div class="octane-defect-density-x-labels"
                                    data-defect-density-x-labels="true"></div>
                              </div>
                              <div class="octane-defect-density-buckets" aria-hidden="true">
                                <j:forEach var="bucket" items="${snapshot.defectTrend.densityBuckets}">
                                  <span data-defect-density-bucket="true"
                                      data-start-millis="${bucket.startMillis}"
                                      data-end-millis="${bucket.endMillis}"
                                      data-new-defects="${bucket.newDefects}"
                                      data-executed-tests="${bucket.executedTests}"
                                      data-density="${bucket.density}"
                                      data-zero-test-spike="${bucket.zeroTestSpike}"></span>
                                </j:forEach>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </section>
          </div>

          <div class="octane-test-management-zone octane-card-zone"
              id="octane-test-management-zone" data-zone-key="test-management"
              data-test-management-json="${it.testManagementJson}">
            <section class="octane-chart-card octane-test-management-card" draggable="true"
                data-card-key="test-management-burndown">
              <div class="octane-card-header">
                <div class="octane-management-header-copy">
                  <h2 class="octane-card-title">Testing Against Schedule</h2>
                  <div class="octane-management-subtitle-line">
                    <div class="octane-management-legend"
                        data-management-legend="true"></div>
                  </div>
                </div>
                <div class="octane-card-actions">
                  <button class="octane-expand-toggle" type="button" aria-label="Expand widget"
                      aria-expanded="false" title="Expand widget">
                    <svg class="octane-action-icon octane-icon-expand" viewBox="0 0 24 24"
                        aria-hidden="true" focusable="false">
                      <path d="M8 4H4v4" />
                      <path d="M16 4h4v4" />
                      <path d="M20 16v4h-4" />
                      <path d="M8 20H4v-4" />
                    </svg>
                    <svg class="octane-action-icon octane-icon-collapse" viewBox="0 0 24 24"
                        aria-hidden="true" focusable="false">
                      <path d="M9 3v6H3" />
                      <path d="M3 9l6-6" />
                      <path d="M15 21v-6h6" />
                      <path d="M21 15l-6 6" />
                    </svg>
                  </button>
                  <button class="octane-card-tools" type="button" aria-label="Move widget"
                      title="Drag to move. Use arrow keys to reorder. Resize from the corner.">
                    <svg class="octane-grabber-icon" viewBox="0 0 24 24" aria-hidden="true"
                        focusable="false">
                      <circle cx="12" cy="5" r="2" />
                      <circle cx="12" cy="12" r="2" />
                      <circle cx="12" cy="19" r="2" />
                    </svg>
                  </button>
                </div>
              </div>
              <div class="octane-management-card-body">
                <div class="octane-management-chart" data-management-burndown="true">
                  <div class="octane-management-plot-layout">
                    <div class="octane-management-y-axis-title">Total Test cases</div>
                    <div class="octane-management-y-labels"
                        data-management-y-labels="true"></div>
                    <div class="octane-management-svg-wrap">
                      <svg class="octane-management-svg" viewBox="0 0 1000 360"
                          preserveAspectRatio="none" role="img"
                          aria-label="Planned, executed, and passed tests over the gate timeline">
                      </svg>
                    </div>
                    <div class="octane-management-x-labels"
                        data-management-x-labels="true"></div>
                  </div>
                </div>
              </div>
            </section>

            <section class="octane-chart-card octane-test-management-card" draggable="true"
                data-card-key="test-management-current-state">
              <div class="octane-card-header">
                <div class="octane-management-header-copy">
                  <h2 class="octane-card-title">Execution per Sprint Parts</h2>
                  <div class="octane-management-subtitle-line">
                    <div class="octane-management-legend"
                        data-management-legend="true"></div>
                  </div>
                </div>
                <div class="octane-card-actions">
                  <button class="octane-expand-toggle" type="button" aria-label="Expand widget"
                      aria-expanded="false" title="Expand widget">
                    <svg class="octane-action-icon octane-icon-expand" viewBox="0 0 24 24"
                        aria-hidden="true" focusable="false">
                      <path d="M8 4H4v4" />
                      <path d="M16 4h4v4" />
                      <path d="M20 16v4h-4" />
                      <path d="M8 20H4v-4" />
                    </svg>
                    <svg class="octane-action-icon octane-icon-collapse" viewBox="0 0 24 24"
                        aria-hidden="true" focusable="false">
                      <path d="M9 3v6H3" />
                      <path d="M3 9l6-6" />
                      <path d="M15 21v-6h6" />
                      <path d="M21 15l-6 6" />
                    </svg>
                  </button>
                  <button class="octane-card-tools" type="button" aria-label="Move widget"
                      title="Drag to move. Use arrow keys to reorder. Resize from the corner.">
                    <svg class="octane-grabber-icon" viewBox="0 0 24 24" aria-hidden="true"
                        focusable="false">
                      <circle cx="12" cy="5" r="2" />
                      <circle cx="12" cy="12" r="2" />
                      <circle cx="12" cy="19" r="2" />
                    </svg>
                  </button>
                </div>
              </div>
              <div class="octane-management-card-body">
                <div class="octane-management-chart" data-management-state="true">
                  <div class="octane-management-plot-layout">
                    <div class="octane-management-y-axis-title">Tests Executed</div>
                    <div class="octane-management-y-labels"
                        data-management-y-labels="true"></div>
                    <div class="octane-management-state-bars"
                        data-management-state-bars="true" role="img"
                        aria-label="Execution statuses across ten equal sprint parts"></div>
                    <div class="octane-management-x-labels"
                        data-management-x-labels="true"></div>
                  </div>
                </div>
              </div>
            </section>

            <section class="octane-chart-card octane-test-management-card" draggable="true"
                data-card-key="test-management-failures">
              <div class="octane-card-header">
                <div class="octane-management-header-copy">
                  <h2 class="octane-card-title">Test Failure Analysis</h2>
                  <div class="octane-management-subtitle-line">
                    <div class="octane-management-legend"
                        data-management-legend="true"></div>
                  </div>
                </div>
                <div class="octane-card-actions">
                  <div class="octane-management-failure-tab-nav"
                      data-management-failure-tab-nav="true"
                      role="group" aria-label="Defect category filters">
                    <button class="octane-management-category-scroll" type="button"
                        data-management-category-scroll="-1" data-visible="false"
                        aria-label="Scroll defect groups left"
                        aria-controls="octane-management-failure-tabs">
                      <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                        <path d="M12.5 4.5L7 10l5.5 5.5" />
                      </svg>
                    </button>
                    <div class="octane-management-failure-switcher"
                        id="octane-management-failure-tabs"
                        data-management-failure-switcher="true"
                        data-selected-category="all"
                        data-selected-status="all"></div>
                    <button class="octane-management-category-scroll" type="button"
                        data-management-category-scroll="1" data-visible="false"
                        aria-label="Scroll defect groups right"
                        aria-controls="octane-management-failure-tabs">
                      <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                        <path d="M7.5 4.5L13 10l-5.5 5.5" />
                      </svg>
                    </button>
                  </div>
                  <button class="octane-expand-toggle" type="button" aria-label="Expand widget"
                      aria-expanded="false" title="Expand widget">
                    <svg class="octane-action-icon octane-icon-expand" viewBox="0 0 24 24"
                        aria-hidden="true" focusable="false">
                      <path d="M8 4H4v4" />
                      <path d="M16 4h4v4" />
                      <path d="M20 16v4h-4" />
                      <path d="M8 20H4v-4" />
                    </svg>
                    <svg class="octane-action-icon octane-icon-collapse" viewBox="0 0 24 24"
                        aria-hidden="true" focusable="false">
                      <path d="M9 3v6H3" />
                      <path d="M3 9l6-6" />
                      <path d="M15 21v-6h6" />
                      <path d="M21 15l-6 6" />
                    </svg>
                  </button>
                  <button class="octane-card-tools" type="button" aria-label="Move widget"
                      title="Drag to move. Use arrow keys to reorder. Resize from the corner.">
                    <svg class="octane-grabber-icon" viewBox="0 0 24 24" aria-hidden="true"
                        focusable="false">
                      <circle cx="12" cy="5" r="2" />
                      <circle cx="12" cy="12" r="2" />
                      <circle cx="12" cy="19" r="2" />
                    </svg>
                  </button>
                </div>
              </div>
              <div class="octane-management-card-body">
                <div class="octane-management-failure-layout"
                    data-management-failures="true">
                  <div class="octane-management-plot-layout
                      octane-management-failure-axis-layout">
                    <div class="octane-management-y-axis-title">Defects</div>
                    <div class="octane-management-y-labels"
                        data-management-y-labels="true"></div>
                    <div class="octane-management-failure-chart"
                        data-management-failure-bars="true" role="group"
                        aria-label="Open and closed defects grouped by root cause"></div>
                  </div>
                  <div class="octane-management-defect-detail-panel">
                    <div class="octane-management-defect-list"
                        data-management-defect-list="true"
                        data-sort-column="id" data-sort-direction="ascending"
                        role="table" aria-colcount="4"
                        aria-label="Failure Analysis defects"></div>
                  </div>
                </div>
              </div>
            </section>

            <section class="octane-chart-card octane-test-management-card" draggable="true"
                data-card-key="test-management-metrics">
              <div class="octane-card-header">
                <div>
                  <h2 class="octane-card-title">Testing Metrics</h2>
                  <div class="octane-muted">QA Health &amp; Compliance</div>
                </div>
                <div class="octane-card-actions">
                  <button class="octane-expand-toggle" type="button" aria-label="Expand widget"
                      aria-expanded="false" title="Expand widget">
                    <svg class="octane-action-icon octane-icon-expand" viewBox="0 0 24 24"
                        aria-hidden="true" focusable="false">
                      <path d="M8 4H4v4" />
                      <path d="M16 4h4v4" />
                      <path d="M20 16v4h-4" />
                      <path d="M8 20H4v-4" />
                    </svg>
                    <svg class="octane-action-icon octane-icon-collapse" viewBox="0 0 24 24"
                        aria-hidden="true" focusable="false">
                      <path d="M9 3v6H3" />
                      <path d="M3 9l6-6" />
                      <path d="M15 21v-6h6" />
                      <path d="M21 15l-6 6" />
                    </svg>
                  </button>
                  <button class="octane-card-tools" type="button" aria-label="Move widget"
                      title="Drag to move. Use arrow keys to reorder. Resize from the corner.">
                    <svg class="octane-grabber-icon" viewBox="0 0 24 24" aria-hidden="true"
                        focusable="false">
                      <circle cx="12" cy="5" r="2" />
                      <circle cx="12" cy="12" r="2" />
                      <circle cx="12" cy="19" r="2" />
                    </svg>
                  </button>
                </div>
              </div>
              <div class="octane-management-card-body">
                <div class="octane-management-metrics-grid"
                    data-management-metrics="true"></div>
              </div>
            </section>
          </div>

          <div class="octane-report-zone octane-card-zone" id="octane-report-zone"
              data-zone-key="reports"
              data-client-rendered="${snapshot.clientRenderedReport}"
              data-report-data-url="data"
              data-report-checksum="${it.reportDataChecksum}">
            <j:choose>
              <j:when test="${snapshot.clientRenderedReport}">
                <section class="octane-chart-card octane-report-client-placeholder"
                    data-card-key="report-loading" aria-live="polite">
                  <div class="octane-card-header">
                    <div>
                      <h2 class="octane-card-title">Suite run charts</h2>
                      <div class="octane-muted">Loading report data...</div>
                    </div>
                  </div>
                  <noscript>
                    <div class="octane-client-noscript-summary">
                      <dl>
                        <dt>Total tests</dt>
                        <dd>${snapshot.projectTestTotal}</dd>
                        <dt>Executed tests</dt>
                        <dd>${snapshot.executedTestCount}</dd>
                        <dt>Passed tests</dt>
                        <dd>${snapshot.passedTestCount}</dd>
                        <dt>Open defects</dt>
                        <dd>${snapshot.openDefectCount}</dd>
                      </dl>
                      <a href="data">Report data (JSON)</a>
                    </div>
                  </noscript>
                </section>
              </j:when>
              <j:when test="${snapshot.hasReportSections()}">
                <j:forEach var="section" items="${snapshot.reportSections}">
                  <section class="octane-chart-card" draggable="true"
                      data-card-key="distribution-${section.source}">
                    <div class="octane-card-header">
                      <div>
                        <h2 class="octane-card-title">${section.statusDistributionTitle}</h2>
                        <div class="octane-muted octane-distribution-subtitle">
                          Total test cases: ${section.metrics.total}
                        </div>
                      </div>
                      <div class="octane-card-actions">
                        <button class="octane-expand-toggle" type="button"
                            aria-label="Expand widget" aria-expanded="false"
                            title="Expand widget">
                          <svg class="octane-action-icon octane-icon-expand" viewBox="0 0 24 24"
                              aria-hidden="true" focusable="false">
                            <path d="M8 4H4v4" />
                            <path d="M16 4h4v4" />
                            <path d="M20 16v4h-4" />
                            <path d="M8 20H4v-4" />
                          </svg>
                          <svg class="octane-action-icon octane-icon-collapse"
                              viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M9 3v6H3" />
                            <path d="M3 9l6-6" />
                            <path d="M15 21v-6h6" />
                            <path d="M21 15l-6 6" />
                          </svg>
                        </button>
                        <button class="octane-card-tools" type="button"
                            aria-label="Move widget"
                            title="Drag to move. Use arrow keys to reorder. Resize from the corner.">
                          <svg class="octane-grabber-icon" viewBox="0 0 24 24" aria-hidden="true"
                              focusable="false">
                            <circle cx="12" cy="5" r="2" />
                            <circle cx="12" cy="12" r="2" />
                            <circle cx="12" cy="19" r="2" />
                          </svg>
                        </button>
                      </div>
                    </div>
                    <div class="octane-chart-inner octane-donut-graph">
                      <div class="octane-donut-layout">
                        <div class="octane-donut-wrap">
                          <svg class="octane-donut" viewBox="3 3 94 94"
                              preserveAspectRatio="xMidYMid meet" role="img"
                              aria-label="${section.statusDistributionTitle}">
                            <title>${section.statusDistributionTitle}</title>
                            <j:forEach var="slice" items="${section.pieSlices}">
                              <j:choose>
                                <j:when test="${slice.fullCircle}">
                                  <circle cx="50" cy="50" r="46" fill="${slice.color}">
                                    <title>${slice.title}</title>
                                  </circle>
                                </j:when>
                                <j:otherwise>
                                  <path class="octane-donut-segment" d="${slice.path}"
                                      fill="${slice.color}">
                                    <title>${slice.title}</title>
                                  </path>
                                </j:otherwise>
                              </j:choose>
                            </j:forEach>
                            <circle class="octane-donut-hole" cx="50" cy="50" r="37.36" />
                            <text class="octane-donut-center-value" x="50" y="46"
                                dominant-baseline="central" text-anchor="middle">
                              ${section.metrics.total}
                            </text>
                            <text class="octane-donut-center-label" x="50" y="57"
                                dominant-baseline="central" text-anchor="middle">
                              Total test cases
                            </text>
                          </svg>
                        </div>
                        <table class="octane-donut-legend">
                          <caption>${section.statusDistributionTitle}</caption>
                          <tbody>
                            <j:forEach var="status" items="${section.totals}">
                              <j:if test="${status.count > 0}">
                                <tr>
                                  <th class="octane-donut-legend-status" scope="row">
                                    <span class="octane-donut-legend-label">
                                      <span class="octane-swatch"
                                          style="background: ${status.color};"
                                          aria-hidden="true"></span>
                                      <span>${status.label}</span>
                                    </span>
                                  </th>
                                  <td class="octane-donut-legend-percentage">
                                    ${status.percentageLabel}
                                  </td>
                                </tr>
                              </j:if>
                            </j:forEach>
                            <j:if test="${section.executedTestCount > 0}">
                              <tr data-automation-usage-row="true">
                                <th class="octane-donut-legend-status" scope="row">
                                  <span class="octane-donut-legend-label">
                                    <span class="octane-automation-icon" aria-hidden="true">${section.automationEmoji}</span>
                                    <span>Automation Usage</span>
                                  </span>
                                </th>
                                <td class="octane-donut-legend-percentage">
                                  ${section.automationPercentageText}
                                </td>
                              </tr>
                            </j:if>
                          </tbody>
                        </table>
                      </div>
                    </div>
                  </section>

                  <section class="octane-chart-card" draggable="true"
                      data-card-key="bars-${section.source}">
                    <div class="octane-card-header">
                      <div>
                        <h2 class="octane-card-title">${section.suiteRunChartTitle}</h2>
                        <div class="octane-suite-chart-meta">
                          <span class="octane-total-label">
                            Total Suiteruns: ${section.suiteRunCount}
                          </span>
                          <div class="octane-legend">
                            <j:forEach var="status" items="${section.totals}">
                              <j:if test="${status.count > 0}">
                                <span class="octane-legend-row">
                                  <span class="octane-swatch"
                                      style="background: ${status.color};"></span>
                                  <span>${status.label}</span>
                                </span>
                              </j:if>
                            </j:forEach>
                          </div>
                        </div>
                      </div>
                      <div class="octane-card-actions">
                        <button class="octane-expand-toggle" type="button"
                            aria-label="Expand widget" aria-expanded="false"
                            title="Expand widget">
                          <svg class="octane-action-icon octane-icon-expand" viewBox="0 0 24 24"
                              aria-hidden="true" focusable="false">
                            <path d="M8 4H4v4" />
                            <path d="M16 4h4v4" />
                            <path d="M20 16v4h-4" />
                            <path d="M8 20H4v-4" />
                          </svg>
                          <svg class="octane-action-icon octane-icon-collapse"
                              viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M9 3v6H3" />
                            <path d="M3 9l6-6" />
                            <path d="M15 21v-6h6" />
                            <path d="M21 15l-6 6" />
                          </svg>
                        </button>
                        <button class="octane-card-tools" type="button"
                            aria-label="Move widget"
                            title="Drag to move. Use arrow keys to reorder. Resize from the corner.">
                          <svg class="octane-grabber-icon" viewBox="0 0 24 24" aria-hidden="true"
                              focusable="false">
                            <circle cx="12" cy="5" r="2" />
                            <circle cx="12" cy="12" r="2" />
                            <circle cx="12" cy="19" r="2" />
                          </svg>
                        </button>
                      </div>
                    </div>
                    <div class="octane-chart-inner octane-bar-graph">
                      <div class="octane-y-axis-label">${section.yAxis}</div>
                      <div class="octane-y-axis-scale">
                        <j:forEach var="tick" items="${section.yAxisTicks}">
                          <span class="octane-axis-value">${tick}</span>
                        </j:forEach>
                      </div>
                      <div class="octane-bar-plot"
                          style="--octane-grid-line-count: ${section.yAxisGridLineCount};">
                        <div class="octane-vertical-bars"
                            data-x-axis="${section.xAxis}"
                            data-y-axis="${section.yAxis}"
                            data-tooltips-enabled="${section.tooltipsEnabled}">
                          <j:forEach var="suiteRun" items="${section.suiteRuns}">
                            <div class="octane-suite-column"
                                tabindex="${section.tooltipsEnabled ? '0' : '-1'}"
                                data-card-key="bars-${section.source}"
                                data-bar-key="${suiteRun.suiteRunId}"
                                data-bar-name="${suiteRun.displayName}"
                                data-bar-total="${suiteRun.total}"
                                data-automation-percentage="${suiteRun.automationPercentage}"
                                data-automation-emoji="${suiteRun.automationEmoji}"
                                data-dominant-status-color="${suiteRun.dominantStatusColor}"
                                data-dominant-status-label="${suiteRun.dominantStatusLabel}"
                                data-status-passed-count="${suiteRun.passedCount}"
                                data-status-passed-color="${suiteRun.passedTooltipColor}"
                                data-status-failed-count="${suiteRun.failedCount}"
                                data-status-failed-color="${suiteRun.failedTooltipColor}"
                                data-status-blocked-count="${suiteRun.blockedCount}"
                                data-status-blocked-color="${suiteRun.blockedTooltipColor}"
                                data-status-skipped-count="${suiteRun.skippedCount}"
                                data-status-skipped-color="${suiteRun.skippedTooltipColor}"
                                data-status-running-count="${suiteRun.runningCount}"
                                data-status-running-color="${suiteRun.runningTooltipColor}"
                                data-status-running-label="In Progress"
                                data-status-in-progress-count="${suiteRun.inProgressCount}"
                                data-status-in-progress-label="In Progress"
                                aria-label="${suiteRun.title}">
                              <div class="octane-vertical-bar-wrap">
                                <div class="octane-vertical-bar" style="${suiteRun.barHeightStyle}">
                                  <j:forEach var="status" items="${suiteRun.statuses}">
                                    <j:if test="${status.count > 0}">
                                      <span class="octane-vertical-segment"
                                          style="${status.heightStyle}"></span>
                                    </j:if>
                                  </j:forEach>
                                </div>
                              </div>
                              <span class="octane-suite-label" title="${suiteRun.title}">
                                ${suiteRun.axisLabel}
                              </span>
                              <j:if test="${section.tooltipsEnabled}">
                                <div class="octane-bar-popup" role="tooltip"
                                    style="--octane-popup-border-color: ${suiteRun.dominantStatusColor};">
                                  <div class="octane-bar-popup-name">${suiteRun.displayName}</div>
                                  <j:forEach var="status" items="${suiteRun.statuses}">
                                    <j:if test="${status.count > 0}">
                                      <div class="octane-bar-popup-row">
                                        <span class="octane-swatch"
                                            style="background: ${status.tooltipColor};"></span>
                                        <span class="octane-bar-popup-label">${status.label}</span>
                                        <span class="octane-bar-popup-value">${status.count}</span>
                                        <span class="octane-bar-popup-percent">
                                          (${status.percentageLabel})
                                        </span>
                                      </div>
                                    </j:if>
                                  </j:forEach>
                                  <div class="octane-bar-popup-automation">
                                    <span class="octane-automation-icon" aria-hidden="true">${suiteRun.automationEmoji}</span>
                                    <span class="octane-bar-popup-label">Automation Usage</span>
                                    <span class="octane-bar-popup-value">
                                      ${suiteRun.automationPercentageText}
                                    </span>
                                  </div>
                                  <div class="octane-bar-popup-total">
                                    <span>Total</span>
                                    <span class="octane-bar-popup-total-value">${suiteRun.total}</span>
                                  </div>
                                </div>
                              </j:if>
                            </div>
                          </j:forEach>
                        </div>
                      </div>
                    </div>
                    <table class="octane-chart-data-summary octane-visually-hidden">
                      <caption>${section.suiteRunChartTitle}</caption>
                      <thead>
                        <tr>
                          <th scope="col">${section.xAxis}</th>
                          <th scope="col">Status</th>
                          <th scope="col">Count</th>
                          <th scope="col">Percent</th>
                          <th scope="col">Total</th>
                        </tr>
                      </thead>
                      <tbody>
                        <j:forEach var="suiteRun" items="${section.suiteRuns}">
                          <j:forEach var="status" items="${suiteRun.statuses}">
                            <j:if test="${status.count > 0}">
                              <tr>
                                <th scope="row">${suiteRun.displayName}</th>
                                <td>${status.label}</td>
                                <td>${status.count}</td>
                                <td>${status.percentageLabel}</td>
                                <td>${suiteRun.total}</td>
                              </tr>
                            </j:if>
                          </j:forEach>
                        </j:forEach>
                      </tbody>
                    </table>
                  </section>
                </j:forEach>
              </j:when>
              <j:when test="${!snapshot.hasSections()}">
                <section class="octane-chart-card" draggable="true"
                    data-card-key="suite-run-empty">
                  <div class="octane-card-header">
                    <div>
                      <h2 class="octane-card-title">Suite run charts</h2>
                      <div class="octane-muted">${snapshot.stateLabel}</div>
                    </div>
                    <div class="octane-card-actions">
                      <button class="octane-expand-toggle" type="button"
                          aria-label="Expand widget" aria-expanded="false" title="Expand widget">
                        <svg class="octane-action-icon octane-icon-expand" viewBox="0 0 24 24"
                            aria-hidden="true" focusable="false">
                          <path d="M8 4H4v4" />
                          <path d="M16 4h4v4" />
                          <path d="M20 16v4h-4" />
                          <path d="M8 20H4v-4" />
                        </svg>
                        <svg class="octane-action-icon octane-icon-collapse" viewBox="0 0 24 24"
                            aria-hidden="true" focusable="false">
                          <path d="M9 3v6H3" />
                          <path d="M3 9l6-6" />
                          <path d="M15 21v-6h6" />
                          <path d="M21 15l-6 6" />
                        </svg>
                      </button>
                      <button class="octane-card-tools" type="button"
                          aria-label="Move widget"
                          title="Drag to move. Use arrow keys to reorder. Resize from the corner.">
                        <svg class="octane-grabber-icon" viewBox="0 0 24 24" aria-hidden="true"
                            focusable="false">
                          <circle cx="12" cy="5" r="2" />
                          <circle cx="12" cy="12" r="2" />
                          <circle cx="12" cy="19" r="2" />
                        </svg>
                      </button>
                    </div>
                  </div>
                  <div class="octane-empty">${snapshot.emptyReportMessage}</div>
                </section>
              </j:when>
            </j:choose>
          </div>
          <section class="octane-tester-details-zone" id="tester-details-zone"
              aria-labelledby="octane-tester-details-title">
            <header class="octane-tester-details-header">
              <h2 class="octane-tester-details-title" id="octane-tester-details-title">
                Tester Details
              </h2>
              <button class="octane-tester-details-toggle" type="button"
                  aria-controls="octane-tester-details-body" aria-expanded="true"
                  aria-label="Collapse tester details" title="Collapse tester details">
                <svg class="octane-action-icon octane-icon-tester-collapse" viewBox="0 0 24 24"
                    aria-hidden="true" focusable="false">
                  <path d="M6 15l6-6 6 6" />
                </svg>
                <svg class="octane-action-icon octane-icon-tester-expand" viewBox="0 0 24 24"
                    aria-hidden="true" focusable="false">
                  <path d="M6 9l6 6 6-6" />
                </svg>
              </button>
            </header>
            <div class="octane-tester-details-body" id="octane-tester-details-body">
              <section class="octane-tester-tracker"
                  aria-labelledby="octane-execution-tracker-title">
                <h3 class="octane-tester-tracker-title" id="octane-execution-tracker-title"
                    data-tester-execution-title="true"
                    aria-label="Testers with LESS THAN ${snapshot.baseExecutionFigure}% Execution (${snapshot.testerExecutionDetailsCount})">
                  <span class="octane-tester-responsive-prefix">Testers with </span><span
                      class="octane-tester-comparison-full">LESS THAN </span><span
                      class="octane-tester-comparison-compact">&lt; </span><span
                      data-tester-title-condition="true">${snapshot.baseExecutionFigure}% Execution (${snapshot.testerExecutionDetailsCount})</span>
                </h3>
                <div class="octane-tester-column-content"
                    data-tester-execution-content="true"
                    data-empty="${snapshot.testerExecutionDetailsEmpty}">
                  <table class="octane-tester-table">
                    <colgroup>
                      <col class="octane-tester-email-column" />
                      <col class="octane-tester-rate-column" />
                    </colgroup>
                    <thead>
                      <tr>
                        <th class="octane-tester-email" scope="col">Email</th>
                        <th class="octane-tester-rate octane-tester-rate-header" scope="col"
                            aria-label="Suiterun Execution">
                          <span class="octane-tester-responsive-prefix">Suiterun </span><span>Execution</span>
                        </th>
                      </tr>
                    </thead>
                    <tbody data-tester-execution-rows="true">
                      <j:forEach var="tester" items="${snapshot.testerExecutionDetails}">
                        <tr>
                          <td class="octane-tester-email">${tester.email}</td>
                          <td class="octane-tester-rate">${tester.executionRateText}</td>
                        </tr>
                      </j:forEach>
                    </tbody>
                  </table>
                  <div class="octane-tester-empty-state">Everything Good!</div>
                </div>
              </section>
              <section class="octane-tester-tracker" aria-labelledby="octane-pass-rate-tracker-title">
                <h3 class="octane-tester-tracker-title" id="octane-pass-rate-tracker-title"
                    data-tester-pass-rate-title="true"
                    aria-label="Testers with LESS THAN ${snapshot.basePassrateFigure}% Pass Rate (${snapshot.testerPassRateDetailsCount})">
                  <span class="octane-tester-responsive-prefix">Testers with </span><span
                      class="octane-tester-comparison-full">LESS THAN </span><span
                      class="octane-tester-comparison-compact">&lt; </span><span
                      data-tester-title-condition="true">${snapshot.basePassrateFigure}% Pass Rate (${snapshot.testerPassRateDetailsCount})</span>
                </h3>
                <div class="octane-tester-column-content"
                    data-tester-pass-rate-content="true"
                    data-empty="${snapshot.testerPassRateDetailsEmpty}">
                  <table class="octane-tester-table">
                    <colgroup>
                      <col class="octane-tester-email-column" />
                      <col class="octane-tester-rate-column" />
                    </colgroup>
                    <thead>
                      <tr>
                        <th class="octane-tester-email" scope="col">Email</th>
                        <th class="octane-tester-rate octane-tester-rate-header" scope="col"
                            aria-label="Suiterun Pass Rate">
                          <span class="octane-tester-responsive-prefix">Suiterun </span><span>Pass Rate</span>
                        </th>
                      </tr>
                    </thead>
                    <tbody data-tester-pass-rate-rows="true">
                      <j:forEach var="tester" items="${snapshot.testerPassRateDetails}">
                        <tr>
                          <td class="octane-tester-email">${tester.email}</td>
                          <td class="octane-tester-rate">${tester.passRateText}</td>
                        </tr>
                      </j:forEach>
                    </tbody>
                  </table>
                  <div class="octane-tester-empty-state">Everything Good!</div>
                </div>
              </section>
              <section class="octane-tester-tracker" aria-labelledby="octane-defined-scope-title">
                <h3 class="octane-tester-tracker-title" id="octane-defined-scope-title">
                  Defined Scope
                </h3>
                <div class="octane-tester-column-content"
                    data-defined-scope-content="true"
                    data-empty="${snapshot.definedScopeEmpty}">
                  <table class="octane-tester-table">
                    <thead>
                      <tr>
                        <th class="octane-scope-project" scope="col">Project</th>
                        <th class="octane-scope-owner" scope="col">Owner</th>
                      </tr>
                    </thead>
                    <tbody data-defined-scope-rows="true">
                      <j:forEach var="scope" items="${snapshot.definedScope}">
                        <tr>
                          <td class="octane-scope-project">${scope.project}</td>
                          <td class="octane-scope-owner">${scope.displayOwner}</td>
                        </tr>
                      </j:forEach>
                    </tbody>
                  </table>
                  <div class="octane-tester-empty-state">No defined scope!</div>
                </div>
              </section>
            </div>
          </section>
        </div>
        <div id="octane-bar-popup-overlay" class="octane-bar-popup" role="tooltip"
            aria-hidden="true"></div>
      </div>
      <script src="scaleReportScript"></script>
      <script src="testManagementScript"></script>
      <st:adjunct includes="js.octane-dashboard" />
    </l:main-panel>
  </l:layout>
</j:jelly>
