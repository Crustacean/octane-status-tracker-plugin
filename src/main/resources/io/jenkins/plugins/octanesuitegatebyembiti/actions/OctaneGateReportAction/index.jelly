        .octane-test-metric-defect-color-very-high {
          background: var(--octane-severity-very-high);
        }
        .octane-test-metric-defect-color-high {
          background: var(--octane-severity-high);
        }
        .octane-test-metric-defect-color-medium {
          background: var(--octane-severity-medium);
        }
        .octane-test-metric-defect-color-low {
          background: var(--octane-severity-low);
        }
        .octane-test-metric-defect-color-unspecified {
          background: var(--octane-severity-unspecified);
        }
        .octane-test-metric-defect-label,
        .octane-test-metric-segment-label {
          color: var(--text-color-secondary);
          display: block;
          font-family: Inter, "Segoe UI", Arial, sans-serif;
          font-size: var(--octane-test-metric-bar-label-font-size);
          line-height: 1.1;
          min-width: 0;
          overflow: hidden;
          text-overflow: clip;
