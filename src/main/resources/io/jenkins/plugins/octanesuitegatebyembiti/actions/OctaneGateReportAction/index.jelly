              clamp(0.1rem, 0.7cqh, 0.2rem);
            gap: 0.04rem;
            padding: clamp(0.18rem, min(1.2cqw, 1.2cqh), 0.4rem);
          }
          .octane-test-metric-heading {
            font-size: clamp(0.4rem, min(2.15cqw, 2.2cqh), 0.58rem);
