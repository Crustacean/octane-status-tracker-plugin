          align-items: baseline;
          display: flex;
          flex-wrap: wrap;
          font-variant-numeric: tabular-nums;
          gap: 0.35rem;
        }
        .octane-report-status-separator {
          color: var(--text-color-secondary);
        }
        .octane-activity-rings {
          box-sizing: border-box;
          container-name: octane-activity-rings;
          container-type: size;
          height: 100%;
          min-height: 0;
          min-width: 0;
          padding: 0;
          width: 100%;
        }
        .octane-activity-rings-layout {
          display: grid;
          height: 100%;
          min-height: 0;
          min-width: 0;
          place-items: center;
          position: relative;
          width: 100%;
        }
        .octane-activity-rings-graphic {
          align-items: center;
          container-type: size;
          display: flex;
          height: 100%;
          justify-content: center;
          min-height: 0;
          min-width: 0;
          width: 100%;
        }
        .octane-timer-donut {
          aspect-ratio: 1 / 1;
          display: block;
          height: min(100cqw, 100cqh, 220px);
          max-height: 220px;
          max-width: 220px;
          overflow: visible;
          shape-rendering: geometricPrecision;
          width: min(100cqw, 100cqh, 220px);
        }
        .octane-activity-rings-svg {
          aspect-ratio: 1;
          display: block;
          height: min(100cqw, 100cqh, 220px);
          max-height: 220px;
          max-width: 220px;
          overflow: visible;
          shape-rendering: geometricPrecision;
          width: min(100cqw, 100cqh, 220px);
        }
        .octane-activity-ring-track,
        .octane-activity-ring-progress {
          fill: none;
          stroke-linecap: round;
          stroke-width: 16;
        }
        .octane-activity-ring-track {
          opacity: 0.2;
        }
        .octane-activity-ring-execution {
          stroke: #FA114F;
        }
        .octane-activity-ring-pass {
          stroke: #A6FF00;
        }
        .octane-activity-ring-automation {
          stroke: #00FFF6;
        }
        .octane-activity-header-copy {
          flex: 1 1 100%;
          max-width: none;
          min-width: 0;
