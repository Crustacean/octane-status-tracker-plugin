          overflow: hidden;
        }
        .octane-test-metric-defect-color {
          border-radius: 0;
          display: block;
          flex: 0 1 var(--octane-test-metric-segment-share);
          height: 100%;
          min-width: 0;
        }
        .octane-test-metric-automation-color {
          border-radius: 0;
          display: block;
          flex: 0 1 var(--octane-test-metric-segment-share);
          height: 100%;
          min-width: 0;
        }
        .octane-test-metric-automation-track
          .octane-test-metric-automation-color:first-child {
          border-bottom-left-radius: 999px;
          border-top-left-radius: 999px;
        }
        .octane-test-metric-automation-track
          .octane-test-metric-automation-color:last-child {
          border-bottom-right-radius: 999px;
          border-top-right-radius: 999px;
        }
        .octane-test-metric-automation-track
          .octane-test-metric-automation-color:only-child {
          border-radius: 999px;
        }
        .octane-test-metric-automation-automated {
          background: var(--octane-system-good);
        }
        .octane-test-metric-automation-manual {
          background: var(--octane-system-bad);
        }
        .octane-test-metric-defect-track
          .octane-test-metric-defect-color:first-child {
          border-bottom-left-radius: 999px;
          border-top-left-radius: 999px;
        }
        .octane-test-metric-defect-track
          .octane-test-metric-defect-color:last-child {
