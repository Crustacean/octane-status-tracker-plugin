          border-color: #4391F5;
          opacity: 0.45;
        }
        .octane-expanded-backdrop {
          background: rgba(0, 0, 0, 0.42);
          inset: 0;
          position: fixed;
          z-index: 2147483645;
        }
        .octane-chart-card.octane-expanded {
          border-color: #4391F5;
          display: flex;
          flex-direction: column;
          height: auto;
          inset: 1rem;
          max-height: none;
          max-width: none;
          min-height: 0;
          min-width: 0;
          overflow: hidden;
          position: fixed;
          resize: none;
          width: auto;
          z-index: 2147483646;
        }
        .octane-chart-card.octane-expanded .octane-icon-expand {
          display: none;
