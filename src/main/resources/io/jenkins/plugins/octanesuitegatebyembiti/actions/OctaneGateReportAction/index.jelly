        }
        .octane-chart-card.octane-expanded .octane-card-tools {
          cursor: default;
        }
        .octane-timer-card {
          flex: 1 1 calc(25% - 0.75rem);
          min-height: 280px;
          min-width: 280px;
          width: calc(25% - 0.75rem);
        }
        .octane-timer-zone:not(.octane-zone-focused)
          > .octane-timer-card:not(.octane-expanded),
        .octane-test-management-zone:not(.octane-zone-focused)
