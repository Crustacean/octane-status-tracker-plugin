          text-wrap: nowrap;
          white-space: nowrap;
          width: 100%;
        }
        .octane-activity-inline-legend {
          display: block;
          font-variant-numeric: tabular-nums;
          min-width: 0;
          overflow: hidden;
          text-overflow: ellipsis;
          text-wrap: nowrap;
          white-space: nowrap;
        }
        .octane-activity-legend-item {
          align-items: center;
          display: inline-flex;
          gap: 0.18rem;
          white-space: nowrap;
        }
        .octane-activity-legend-item:not(:last-child) {
          margin-inline-end: 0.45rem;
        }
        .octane-activity-legend-compact {
          display: none;
        }
        .octane-activity-ring-swatch {
          border-radius: 50%;
          display: inline-block;
          flex: 0 0 auto;
          height: 0.56rem;
          margin-right: 0.08rem;
          width: 0.56rem;
